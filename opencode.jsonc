{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md", "docs/*.md"],
  "mcp": {
    "Astro docs": {
      "type": "remote",
      "url": "https://mcp.docs.astro.build/mcp",
      "enabled": true,
    },
    "fallow": {
      "type": "local",
      "command": ["vpx", "fallow-mcp"],
      "enabled": true,
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}",
      },
    },
    "mux": {
      "type": "remote",
      "url": "https://mcp.mux.com",
      "enabled": true,
      "oauth": false,
    },
    "cloudflare-docs": {
      "type": "remote",
      "url": "https://docs.mcp.cloudflare.com/mcp",
      "enabled": true,
    },
    "netlify": {
      "type": "local",
      "command": ["vpx", "-y", "@netlify/mcp"],
      "enabled": true,
    },
  },
  "plugin": ["opencode-dynamic-context-pruning"],
  "permission": {
    "bash": {
      "npm *": "deny",
      "npx *": "deny",
      "pnpm *": "deny",
      "pn *": "deny",
    },
  },
}
