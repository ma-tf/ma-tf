{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md", "docs/*.md"],
  "mcp": {
    "servers": {
      "Astro docs": {
        "type": "remote",
        "url": "https://mcp.docs.astro.build/mcp",
      },
      "fallow": {
        "type": "local",
        "command": ["vpx", "fallow-mcp"],
      },
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}",
        },
      },
      "mux": {
        "type": "remote",
        "url": "https://mcp.mux.com",
      },
      "cloudflare-docs": {
        "type": "remote",
        "url": "https://docs.mcp.cloudflare.com/mcp",
      },
      "netlify": {
        "type": "local",
        "command": ["npx", "--force", "-y", "@netlify/mcp"],
      },
    },
  },
  "permissions": [
    {
      "action": "shell",
      "resource": "npm *",
      "effect": "deny",
    },
    {
      "action": "shell",
      "resource": "npx *",
      "effect": "deny",
    },
    {
      "action": "shell",
      "resource": "pnpm *",
      "effect": "deny",
    },
    {
      "action": "shell",
      "resource": "pn *",
      "effect": "deny",
    },
  ],
}
