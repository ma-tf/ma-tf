    "remark-gfm": "^4.0.1",
    "shadcn": "^4.22.0",
    "tailwindcss": "^4.3.3",
    "turndown": "^7.2.4",
    "tw-animate-css": "^1.4.0",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
