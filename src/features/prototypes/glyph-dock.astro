---
import "../../styles/prototypes.css";
import type { PrototypeSection } from "@features/prototypes/prototype-content";
import {
  ArticleIcon,
  CameraIcon,
  CodeIcon,
  FilmStripIcon,
  MusicNotesIcon,
  PaletteIcon,
} from "@phosphor-icons/react";

type Props = { sections: PrototypeSection[] };

const { sections } = Astro.props;

const icons = {
  blog: ArticleIcon,
  projects: CodeIcon,
  photography: CameraIcon,
  vignettes: FilmStripIcon,
  graphics: PaletteIcon,
  music: MusicNotesIcon,
};

const keys = sections.map((section) => ({ ...section, Glyph: icons[section.tone] }));
---

<div class="gd-root">
  <div class="gd-back" aria-hidden="true">
    {
      keys.map((key) => {
        const backdrop = key.backdrop ?? key.images.slice(0, 1);
        return (
          <span class="gd-scene" data-tone={key.tone}>
            {backdrop.map((image) => (
              <img
                class="gd-scene-image"
                src={image.src}
                alt=""
                loading="lazy"
                decoding="async"
              />
            ))}
            <span class="gd-wash"></span>
            <span class="gd-tint"></span>
            <span class="gd-scrim"></span>
          </span>
        );
      })
    }
  </div>

  <div class="gd-plate" aria-hidden="true">
    <div class="gd-mount">
      <span class="gd-crop"></span>
      <span class="gd-reg gd-reg-tl"></span>
      <span class="gd-reg gd-reg-tr"></span>
      <span class="gd-reg gd-reg-bl"></span>
      <span class="gd-reg gd-reg-br"></span>
    </div>
    <div class="gd-captions">
      {
        keys.map((key) => (
          <span class="gd-caption" data-tone={key.tone}>
            <span class="gd-caption-label proto-mono">
              <span class="gd-caption-swatch"></span>
              <span class="gd-caption-text">{key.label}</span>
            </span>
            <span class="gd-caption-count proto-mono">{key.count}</span>
          </span>
        ))
      }
    </div>
  </div>

  <div class="gd-notes" aria-hidden="true">
    {
      keys.map((key) => (
        <p class="gd-note" data-tone={key.tone}>{key.subtitle}</p>
      ))
    }
  </div>

  <div class="gd-left">
    <div class="gd-frames" aria-hidden="true">
      {
        keys.map((key) => (
          <span class="gd-frame" data-tone={key.tone}>
            <span class="gd-bar"></span>
            <span class="gd-index proto-mono">{key.index}</span>
            <span class="gd-name">{key.label}</span>
          </span>
        ))
      }
    </div>

    <div class="gd-dock" role="group" aria-label="Sections">
      {
        keys.map((key) => {
          const Glyph = key.Glyph;
          return (
            <button class="gd-key" type="button" data-tone={key.tone} aria-label={key.label}>
              <Glyph size={20} weight="regular" />
            </button>
          );
        })
      }
    </div>
  </div>
</div>

<style>
  .gd-root {
    --gd-key: 40px;
    --gd-inset: 24px;
    --gd-gap: 6px;
    --gd-floor: 52px;
    --gd-name-size: 1.6rem;
    --gd-bar: 24px;
    position: relative;
    flex: 1 1 auto;
    min-height: 0;
  }

  .gd-back {
    position: absolute;
    inset: 0;
    z-index: -2;
    overflow: hidden;
    background: var(--proto-paper);
    pointer-events: none;
  }

  .gd-scene {
    position: absolute;
    inset: 0;
    isolation: isolate;
    opacity: 0;
    transition: opacity 150ms var(--proto-ease);
  }

  .gd-scene-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.08);
    opacity: 0.88;
  }

  .gd-wash {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        120% 90% at 78% 16%,
        color-mix(in oklab, var(--proto-tone) 62%, transparent),
        transparent 68%
      ),
      linear-gradient(
        118deg,
        color-mix(in oklab, var(--proto-tone) 52%, transparent),
        transparent 72%
      );
    mix-blend-mode: color;
  }

  .gd-tint {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      132deg,
      color-mix(in oklab, var(--proto-tone) 20%, transparent),
      transparent 62%
    );
  }

  .gd-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to right,
      var(--proto-paper) 0%,
      color-mix(in oklab, var(--proto-paper) 92%, transparent) 40%,
      color-mix(in oklab, var(--proto-paper) 62%, transparent) 58%,
      color-mix(in oklab, var(--proto-paper) 12%, transparent) 78%,
      transparent 92%
    );
  }

  .gd-plate {
    display: none;
  }

  .gd-mount {
    position: relative;
    flex: 1;
    min-height: 0;
    padding: 10px;
    border: 1px solid var(--proto-ink);
  }

  .gd-crop {
    position: relative;
    display: block;
    height: 100%;
    overflow: hidden;
  }

  .gd-reg {
    position: absolute;
    display: block;
    width: 15px;
    height: 15px;
    color: color-mix(in oklab, var(--proto-ink) 72%, transparent);
  }

  .gd-reg::before,
  .gd-reg::after {
    content: "";
    position: absolute;
    display: block;
    background: currentColor;
  }

  .gd-reg::before {
    top: 0;
    left: 7px;
    width: 1px;
    height: 15px;
  }

  .gd-reg::after {
    top: 7px;
    left: 0;
    width: 15px;
    height: 1px;
  }

  .gd-reg-tl {
    top: 2px;
    left: 2px;
  }

  .gd-reg-tr {
    top: 2px;
    right: 2px;
  }

  .gd-reg-bl {
    bottom: 2px;
    left: 2px;
  }

  .gd-reg-br {
    right: 2px;
    bottom: 2px;
  }

  .gd-captions {
    display: grid;
  }

  .gd-caption {
    display: flex;
    grid-area: 1 / 1;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding-top: 6px;
    border-top: 1px solid var(--proto-ink);
    font-size: 9px;
    letter-spacing: 0.14em;
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 150ms var(--proto-ease),
      transform 150ms var(--proto-ease);
  }

  .gd-caption-label {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 9px;
  }

  .gd-caption-swatch {
    display: block;
    width: 7px;
    height: 7px;
    background: var(--proto-tone);
  }

  .gd-caption-text,
  .gd-caption-count {
    color: var(--proto-ink);
    text-shadow: 0 0 4px var(--proto-paper);
  }

  .gd-caption-count {
    font-size: 9px;
  }

  .gd-notes {
    position: absolute;
    top: 32px;
    right: var(--gd-inset);
    display: grid;
    width: calc(100vw - (var(--gd-inset) * 2));
    pointer-events: none;
  }

  .gd-note {
    position: relative;
    display: grid;
    align-content: end;
    grid-area: 1 / 1;
    margin: 0;
    padding: 1rem;
    padding-top: clamp(3rem, 9vw, 10rem);
    border: 1px solid var(--proto-ink);
    font-family: var(--font-heading);
    font-weight: 300;
    font-size: clamp(1.75rem, 6vw, 3rem);
    line-height: 1.05;
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 150ms var(--proto-ease),
      transform 150ms var(--proto-ease);
  }

  .gd-note::before {
    content: "";
    position: absolute;
    inset: 7px;
    pointer-events: none;
    background-image:
      linear-gradient(var(--proto-tone), var(--proto-tone)),
      linear-gradient(var(--proto-tone), var(--proto-tone)),
      linear-gradient(var(--proto-tone), var(--proto-tone)),
      linear-gradient(var(--proto-tone), var(--proto-tone));
    background-repeat: no-repeat;
    background-position:
      left top,
      right top,
      right bottom,
      left bottom;
    background-size:
      0 1px,
      1px 0,
      0 1px,
      1px 0;
    transition: background-size 420ms var(--proto-ease);
  }

  .gd-frames {
    position: absolute;
    bottom: calc(var(--gd-floor) + var(--gd-key) + 24px);
    left: var(--gd-inset);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--gd-gap);
    pointer-events: none;
  }

  .gd-frame {
    display: grid;
    grid-template-columns: 12px auto auto;
    justify-content: start;
    align-items: center;
    column-gap: 12px;
    opacity: 1;
    cursor: pointer;
    pointer-events: auto;
    transition: opacity 300ms var(--proto-ease);
  }

  .gd-bar {
    justify-self: start;
    width: 2px;
    height: var(--gd-bar);
    background: color-mix(in oklab, var(--proto-ink) 32%, transparent);
    transition:
      width 150ms var(--proto-ease),
      background-color 150ms var(--proto-ease);
  }

  .gd-index {
    color: color-mix(in oklab, var(--proto-ink) 42%, transparent);
    font-size: 10px;
  }

  .gd-name {
    color: var(--proto-ink);
    font-family: var(--font-heading);
    font-size: var(--gd-name-size);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.035em;
    text-align: left;
    white-space: nowrap;
  }

  .gd-dock {
    position: absolute;
    bottom: var(--gd-floor);
    left: var(--gd-inset);
    display: none;
    gap: var(--gd-gap);
  }

  .gd-key {
    display: grid;
    place-items: center;
    width: var(--gd-key);
    height: var(--gd-key);
    padding: 0;
    border: 1px solid color-mix(in oklab, var(--proto-ink) 22%, transparent);
    background: var(--proto-paper);
    color: color-mix(in oklab, var(--proto-ink) 58%, transparent);
    cursor: pointer;
    transition:
      color 120ms var(--proto-ease),
      background-color 120ms var(--proto-ease),
      border-color 120ms var(--proto-ease),
      border-bottom-width 150ms var(--proto-ease),
      transform 150ms var(--proto-ease);
  }

  .gd-key:hover,
  .gd-key:focus-visible,
  .gd-root[data-gd-active="0"] .gd-key:nth-child(1),
  .gd-root[data-gd-active="1"] .gd-key:nth-child(2),
  .gd-root[data-gd-active="2"] .gd-key:nth-child(3),
  .gd-root[data-gd-active="3"] .gd-key:nth-child(4),
  .gd-root[data-gd-active="4"] .gd-key:nth-child(5),
  .gd-root[data-gd-active="5"] .gd-key:nth-child(6) {
    border-color: var(--proto-tone);
    border-bottom-width: 3px;
    border-bottom-color: color-mix(in oklab, var(--proto-tone) 72%, black);
    background: color-mix(in oklab, var(--proto-tone) 12%, var(--proto-paper));
    color: color-mix(in oklab, var(--proto-tone) 82%, var(--proto-ink));
    transform: translateY(-2px);
  }

  .gd-root[data-gd-active] .gd-key:not([aria-current="true"]) {
    color: color-mix(in oklab, var(--proto-ink) 30%, transparent);
  }

  .gd-root[data-gd-active="0"] .gd-scene:nth-child(1),
  .gd-root[data-gd-active="1"] .gd-scene:nth-child(2),
  .gd-root[data-gd-active="2"] .gd-scene:nth-child(3),
  .gd-root[data-gd-active="3"] .gd-scene:nth-child(4),
  .gd-root[data-gd-active="4"] .gd-scene:nth-child(5),
  .gd-root[data-gd-active="5"] .gd-scene:nth-child(6) {
    opacity: 1;
  }

  .gd-root[data-gd-active="0"] .gd-note:nth-child(1),
  .gd-root[data-gd-active="0"] .gd-caption:nth-child(1),
  .gd-root[data-gd-active="1"] .gd-note:nth-child(2),
  .gd-root[data-gd-active="1"] .gd-caption:nth-child(2),
  .gd-root[data-gd-active="2"] .gd-note:nth-child(3),
  .gd-root[data-gd-active="2"] .gd-caption:nth-child(3),
  .gd-root[data-gd-active="3"] .gd-note:nth-child(4),
  .gd-root[data-gd-active="3"] .gd-caption:nth-child(4),
  .gd-root[data-gd-active="4"] .gd-note:nth-child(5),
  .gd-root[data-gd-active="4"] .gd-caption:nth-child(5),
  .gd-root[data-gd-active="5"] .gd-note:nth-child(6),
  .gd-root[data-gd-active="5"] .gd-caption:nth-child(6) {
    opacity: 1;
    transform: none;
  }

  .gd-root[data-gd-active="0"] .gd-note:nth-child(1)::before,
  .gd-root[data-gd-active="1"] .gd-note:nth-child(2)::before,
  .gd-root[data-gd-active="2"] .gd-note:nth-child(3)::before,
  .gd-root[data-gd-active="3"] .gd-note:nth-child(4)::before,
  .gd-root[data-gd-active="4"] .gd-note:nth-child(5)::before,
  .gd-root[data-gd-active="5"] .gd-note:nth-child(6)::before {
    background-size:
      100% 1px,
      1px 100%,
      100% 1px,
      1px 100%;
  }

  .gd-root[data-gd-active] .gd-frame {
    opacity: 0.35;
  }

  .gd-root[data-gd-active="0"] .gd-frame:nth-child(1),
  .gd-root[data-gd-active="1"] .gd-frame:nth-child(2),
  .gd-root[data-gd-active="2"] .gd-frame:nth-child(3),
  .gd-root[data-gd-active="3"] .gd-frame:nth-child(4),
  .gd-root[data-gd-active="4"] .gd-frame:nth-child(5),
  .gd-root[data-gd-active="5"] .gd-frame:nth-child(6) {
    opacity: 1;
  }

  .gd-root[data-gd-active="0"] .gd-frame:nth-child(1) .gd-bar,
  .gd-root[data-gd-active="1"] .gd-frame:nth-child(2) .gd-bar,
  .gd-root[data-gd-active="2"] .gd-frame:nth-child(3) .gd-bar,
  .gd-root[data-gd-active="3"] .gd-frame:nth-child(4) .gd-bar,
  .gd-root[data-gd-active="4"] .gd-frame:nth-child(5) .gd-bar,
  .gd-root[data-gd-active="5"] .gd-frame:nth-child(6) .gd-bar {
    width: 14px;
    background: var(--proto-tone);
  }

  @media (min-width: 768px) {
    .gd-root {
      --gd-key: 46px;
      --gd-inset: 40px;
      --gd-gap: 8px;
      --gd-floor: 60px;
      --gd-name-size: clamp(2.25rem, min(7.6vw, 12.6vh), 7.5rem);
      --gd-bar: clamp(28px, 4.2vh, 52px);
    }

    .gd-name {
      line-height: 0.94;
      letter-spacing: -0.05em;
    }

    .gd-left {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: flex-start;
      gap: 24px;
      padding: clamp(20px, 3.4vh, 48px) clamp(24px, 4vw, 64px);
      pointer-events: none;
    }

    .gd-frames {
      position: static;
      gap: 0;
    }

    .gd-dock {
      position: static;
      pointer-events: auto;
    }

    .gd-frame {
      grid-template-columns: 14px auto auto;
      column-gap: clamp(12px, 1.4vw, 22px);
      padding: clamp(2px, 0.7vh, 8px) 0;
    }

    .gd-index {
      font-size: 11px;
    }

    .gd-plate {
      position: absolute;
      top: 40px;
      right: calc(var(--gd-inset) + 64px);
      bottom: calc(var(--gd-floor) + var(--gd-key) + 24px);
      display: flex;
      width: calc(42% + 100px);
      flex-direction: column;
      gap: 8px;
      opacity: 0;
      transform: translateY(6px);
      pointer-events: none;
      transition:
        opacity 150ms var(--proto-ease),
        transform 150ms var(--proto-ease);
    }

    .gd-root[data-gd-active] .gd-plate {
      opacity: 1;
      transform: none;
    }

    .gd-notes {
      top: 80px;
      right: var(--gd-inset);
      width: calc((100vw - (var(--gd-inset) * 2)) / 3);
    }

    .gd-note {
      font-size: clamp(1.75rem, 3.2vw, 3rem);
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>(".gd-root");
  const keys = root ? Array.from(root.querySelectorAll<HTMLButtonElement>(".gd-key")) : [];
  const frames = root ? Array.from(root.querySelectorAll<HTMLElement>(".gd-frame")) : [];
  const plate = root?.querySelector<HTMLElement>(".gd-plate") ?? null;
  const calm = window.matchMedia("(prefers-reduced-motion: reduce)");

  const clear = (event: PointerEvent) => {
    const next = event.relatedTarget;
    if (next instanceof Element && next.closest(".gd-frame, .gd-key")) return;
    if (root) {
      delete root.dataset.gdActive;
    }
    keys.forEach((other) => other.removeAttribute("aria-current"));
  };

  keys.forEach((key, index) => {
    const activate = () => {
      if (root) {
        root.dataset.gdActive = String(index);
      }
      keys.forEach((other) => other.removeAttribute("aria-current"));
      key.setAttribute("aria-current", "true");
      if (plate && !calm.matches) {
        plate.getAnimations().forEach((animation) => animation.cancel());
        plate.animate(
          [
            { opacity: 0, transform: "translateY(6px)" },
            { opacity: 1, transform: "none" },
          ],
          { duration: 150, easing: "cubic-bezier(0.22, 1, 0.36, 1)" },
        );
      }
    };

    key.addEventListener("pointerenter", activate);
    key.addEventListener("focus", activate);
    key.addEventListener("pointerleave", clear);
    frames[index]?.addEventListener("pointerenter", activate);
    frames[index]?.addEventListener("pointerleave", clear);
  });

  root?.addEventListener("pointerleave", () => {
    if (root) {
      delete root.dataset.gdActive;
    }
    keys.forEach((other) => other.removeAttribute("aria-current"));
  });
</script>
