---
import { getCollection, render } from "astro:content";
import {
	Education,
	EducationHeader,
	EducationInstitution,
	EducationLocation,
	EducationDetails,
	EducationCourses,
	EducationCourse,
	EducationPeriod,
	EducationGrade,
} from "@features/cv/education";

const education = await getCollection("education");
const rendered = await Promise.all(
	education.map(async (entry) => ({
		...entry,
		rendered: await render(entry),
	})),
);
---

{
	rendered.map(async (entry) => {
		const { Content } = entry.rendered;
		const { institution, location, start, finish, courses } = entry.data;
		return (
			<Education>
				<EducationHeader>
					<EducationInstitution>
						{institution}
						<EducationLocation>{location}</EducationLocation>
					</EducationInstitution>
					<EducationDetails>
						<EducationCourses>
							{courses.map((course) => (
								<EducationCourse>
									{course.name}
									{course.grade && (
										<EducationGrade>{course.grade}</EducationGrade>
									)}
								</EducationCourse>
							))}
						</EducationCourses>
						<EducationPeriod start={start} finish={finish} />
					</EducationDetails>
				</EducationHeader>
				<Content />
			</Education>
		);
	})
}
