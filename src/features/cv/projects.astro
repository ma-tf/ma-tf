---
import { getCollection, render } from "astro:content";
import {
  Project,
  ProjectContent,
  ProjectHeader,
  ProjectTitle,
  ProjectTopic,
  ProjectTopics,
  ProjectsGrid,
} from "@features/cv/projects";

const projects = await getCollection("projects");
const rendered = await Promise.all(
  projects.map(async (entry) => ({
    ...entry,
    rendered: await render(entry),
  })),
);
---

<ProjectsGrid>
  {
    rendered.map(async (project) => {
      const { Content } = project.rendered;
      const { title, url, topics } = project.data;
      return (
        <Project>
          <ProjectHeader>
            <ProjectTitle href={url}>{title}</ProjectTitle>
            <ProjectTopics>
              {topics.map((topic) => (
                <ProjectTopic>{topic}</ProjectTopic>
              ))}
            </ProjectTopics>
          </ProjectHeader>
          <ProjectContent>
            <Content />
          </ProjectContent>
        </Project>
      );
    })
  }
</ProjectsGrid>
