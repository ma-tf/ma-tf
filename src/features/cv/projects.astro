---
import { getCollection, render } from "astro:content";
import {
  Card,
  CardHeader,
  CardTitle,
  CardDescription,
  CardContent,
} from "@components/ui/card";

const projects = await getCollection("projects");
const rendered = await Promise.all(
  projects.map(async (entry) => ({
    ...entry,
    rendered: await render(entry),
  })),
);
---

<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 md:grid-cols-4">
  {
    rendered.map(async (project, _index) => {
      const { Content } = project.rendered;
      const { title, url, topics } = project.data;
      return (
        <Card>
          <CardHeader>
            {/* <span class="text-8xl text-muted-foreground origin-left rotate-90">
              {String(index + 1).padStart(2, "0")}.
            </span> */}
            <CardTitle>
              <a href={url}>{title}</a>
            </CardTitle>
            <CardDescription>{topics.join(" · ")}</CardDescription>
          </CardHeader>
          <CardContent>
            <Content />
          </CardContent>
        </Card>
      );
    })
  }
</div>
