---
import {
	PhotographyColumnItem,
} from "@features/photography/photography-column-item";
import { type PhotographyDialogPhoto } from "@features/photography/photography-column-item-context";
import { render, type CollectionEntry } from "astro:content";

interface Props {
	items: {
		photography: CollectionEntry<"photography">;
		photo: PhotographyDialogPhoto;
	}[];
	orientation: "portrait" | "square";
}

const { items, orientation } = Astro.props;
const rowSpan = orientation === "portrait" ? "md:row-span-3" : "md:row-span-2";

const renderedItems = await Promise.all(
	items.map(async (item) => ({
		...item,
		Content: (await render(item.photography)).Content,
	})),
);
---

<div class="grid grid-cols-1 gap-4">
	{
		renderedItems.map(({ photo, Content }) => {
			return (
				<div class:list={[rowSpan, "grid md:animate-reveal"]}>
					<PhotographyColumnItem photo={photo} orientation={orientation} client:load>
						<Content />
					</PhotographyColumnItem>
				</div>
			);
		})
	}
</div>
