---
import { getCollection } from "astro:content";
import PhotographyColumn from "@features/photography/photography-column.astro";

const r2 = import.meta.env.R2_PUBLIC_URL;

const photography = await getCollection("photography");

const processed = photography.map((photography) => {
	const base = encodeURI(`${r2}/${photography.data.image}`);

	return {
		photography,
		photo: {
			src: `${base}.webp`,
			thumbSrc: `${base}_thumb.webp`,
			alt: photography.body || "Photography",
			camera: photography.data.camera,
			film: photography.data.film,
		},
	};
});

const sortByOrder = (
	a: (typeof processed)[number],
	b: (typeof processed)[number],
) => a.photography.data.order - b.photography.data.order;

const first = processed
	.filter((p) => p.photography.data.column === 1)
	.sort(sortByOrder);
const middle = processed
	.filter((p) => p.photography.data.column === 2)
	.sort(sortByOrder);
const last = processed
	.filter((p) => p.photography.data.column === 3)
	.sort(sortByOrder);
---

<div class="grid grid-cols-1 gap-4 lg:grid-cols-3">
	<PhotographyColumn items={first} orientation="square" />
	<PhotographyColumn items={middle} orientation="portrait" />
	<PhotographyColumn items={last} orientation="square" />
</div>
