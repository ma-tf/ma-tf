---
import { Photograph } from "@components/photograph";
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
  col: CollectionEntry<"photography">[];
}

const { col } = Astro.props;
---

<div class="flex flex-col gap-4">
  {col.map((photo) => (
    <Photograph photo={photo} client:load>
      <Image
        src={photo.data.image}
        alt={photo.body || "Photography"}
        quality="mid"
        height={1000}
        width={1000}
        class:list={[
          "size-full object-cover transition-transform duration-200 hover:scale-110",
          photo.data.column === 2 ? "aspect-2/3" : "aspect-square",
        ]}
      />
    </Photograph>
  ))}
</div>
