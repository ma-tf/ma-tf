---
import { Image, getImage } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { PhotoDialog } from "@components/photo-dialog";

interface Props {
  col: CollectionEntry<"photography">[];
}

const { col } = Astro.props;

const photos = await Promise.all(
  col.map(async (photo) => ({
    photo,
    fullSrc: (await getImage({ src: photo.data.image, quality: "low" })).src,
  })),
);
---

<div class="flex flex-col gap-4">
  {
    photos.map(({ photo, fullSrc }) => {
      const alt = photo.body || "Photography";
      return (
        <PhotoDialog src={fullSrc} alt={alt} client:load>
          <Image
            src={photo.data.image}
            alt={alt}
            quality="mid"
            height={1000}
            width={1000}
            loading="lazy"
            decoding="async"
            fetchpriority="auto"
            class:list={[
              "size-full object-cover transition-transform duration-200 hover:scale-110",
              photo.data.column === 2 ? "aspect-2/3" : "aspect-square",
            ]}
          />
        </PhotoDialog>
      );
    })
  }
</div>
