---
import { getImage } from "astro:assets";
import { getCollection } from "astro:content";
import { S3Client, GetObjectCommand } from "@aws-sdk/client-s3";
import { getSignedUrl } from "@aws-sdk/s3-request-presigner";
import PhotoColumn from "@components/photo-column.astro";

const s3 = new S3Client({
  region: "auto",
  endpoint: import.meta.env.R2_ENDPOINT,
  credentials: {
    accessKeyId: import.meta.env.R2_ACCESS_KEY_ID,
    secretAccessKey: import.meta.env.R2_SECRET_ACCESS_KEY,
  },
});

const photos = await getCollection("photography");

const processed = await Promise.all(
	photos.map(async (photo) => {
		const signedUrl = await getSignedUrl(
			s3,
			new GetObjectCommand({
				Bucket: import.meta.env.R2_BUCKET,
				Key: photo.data.image,
			}),
			{ expiresIn: 3600 },
		);
		return {
			photo,
			fullSrc: (await getImage({ src: signedUrl, quality: "mid", inferSize: true })).src,
			thumbSrc: (
				await getImage({
					src: signedUrl,
					quality: "low",
					height: 1000,
					width: 1000,
					inferSize: true,
				})
			).src,
		};
	}),
);

const sortByOrder = (
	a: (typeof processed)[number],
	b: (typeof processed)[number],
) => a.photo.data.order - b.photo.data.order;

const first = processed
	.filter((p) => p.photo.data.column === 1)
	.sort(sortByOrder);
const middle = processed
	.filter((p) => p.photo.data.column === 2)
	.sort(sortByOrder);
const last = processed
	.filter((p) => p.photo.data.column === 3)
	.sort(sortByOrder);
---

<div class="grid grid-cols-1 gap-4 py-4 lg:grid-cols-3 lg:col-span-4">
	<PhotoColumn items={first} orientation="square" />
	<PhotoColumn items={middle} orientation="portrait" />
	<PhotoColumn items={last} orientation="square" />
</div>
