---
import {
	ArrowCounterClockwiseIcon,
	FastForwardIcon,
} from "@phosphor-icons/react/ssr";
---

<button
	type="button"
	data-motion-control
	data-mode="hidden"
	aria-label="Skip animations"
	title="Skip animations"
	class="grid h-full cursor-pointer place-items-center px-2 text-muted-foreground drop-shadow-emboss transition-colors duration-150 hover:text-foreground dark:text-muted dark:hover:text-background"
>
	<FastForwardIcon
		size={12}
		weight="bold"
		className="motion-control-icon motion-control-skip col-start-1 row-start-1"
	/>
	<ArrowCounterClockwiseIcon
		size={12}
		weight="bold"
		className="motion-control-icon motion-control-reset col-start-1 row-start-1"
	/>
</button>

<script>
	import { startMotionControl } from "@lib/motion-control";

	startMotionControl();
</script>
