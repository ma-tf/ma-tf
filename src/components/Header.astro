---
import { CommandMenu } from "@components/command-menu";
import { ModeToggle } from "@components/ModeToggle";
import MotionControlButton from "@components/MotionControlButton.astro";
import { siteIdentity } from "@features/seo/site-metadata";
import { siteNavLinks } from "@lib/site-nav";
---

<header class="fixed top-0 z-50 flex h-8 w-full items-center px-2">
  <a
    href="/"
    aria-label="m4t.tf home"
    class="group flex items-center gap-2 font-mono text-xs tracking-widest text-muted-foreground uppercase transition-colors duration-150 hover:text-foreground"
  >
    <img
      src="/favicon.png"
      alt=""
      width="16"
      height="16"
      class="size-4 shrink-0 opacity-80 transition-opacity duration-150 group-hover:opacity-100"
    />
    <!-- m4t.tf -->
  </a>
  <div class="fixed top-0 right-0 z-50 flex items-center">
    <CommandMenu
      pages={siteNavLinks}
      email={siteIdentity.email}
      github={siteIdentity.github}
      linkedin={siteIdentity.linkedin}
      client:load
    />
    <MotionControlButton />
    <ModeToggle client:load />
  </div>
</header>
