---
import { ArrowUpIcon, BracketsCurlyIcon } from "@phosphor-icons/react";
import { previews } from "@lib/feature-flags";

const exploreLinks = [
  { label: "Blog", href: "/blog", enabled: previews.blog },
  { label: "Photography", href: "/photography", enabled: previews.photography },
  { label: "Graphics", href: "/graphics", enabled: previews.graphics },
  { label: "Music", href: "/music", enabled: previews.music },
  { label: "Vignettes", href: "/vignettes", enabled: previews.vignettes },
].filter((link) => link.enabled);

const columns = [
  {
    title: "Explore",
    links: exploreLinks,
  },
  {
    title: "Site",
    links: [
      { label: "About", href: "/about" },
      { label: "Contact", href: "/contact" },
      { label: "Privacy", href: "/privacy" },
    ],
  },
  {
    title: "Resources",
    links: [
      { label: "Developers", href: "/developers", icon: BracketsCurlyIcon },
    ],
  },
].filter((column) => column.links.length > 0);

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<footer
  class="static z-50 w-full border-t border-border bg-background text-foreground md:fixed md:bottom-0 md:h-4"
>
  <nav
    aria-label="Footer"
    class="mx-auto grid w-full max-w-480 grid-cols-2 gap-4 pt-4 pb-8 md:flex md:h-full md:items-stretch md:gap-0 md:py-0"
  >
    {
      columns.map((column, columnIndex) => {
        const isLast = columnIndex === columns.length - 1;
        return (
          <div
            class:list={[
              "grid content-start gap-4 px-4 md:flex md:gap-0 md:px-0",
              isLast && "md:ms-auto",
            ]}
          >
            <span class="pt-1 pb-2 text-2xs font-semibold tracking-wider text-foreground uppercase md:hidden">
              {column.title}
            </span>
            {column.links.map((link, index) => {
              const isCurrent = link.href === currentPath;
              const Icon = "icon" in link ? link.icon : undefined;
              return (
                <a
                  href={link.href}
                  aria-current={isCurrent ? "page" : undefined}
                  class:list={[
                    "flex items-center gap-1 py-1 text-xs tracking-wider uppercase transition-colors duration-150 md:px-3 md:py-0 md:text-2xs",
                    "text-muted-foreground hover:text-foreground aria-[current=page]:text-foreground",
                    index > 0 && "md:border-l md:border-foreground/20",
                  ]}
                >
                  {Icon && <Icon size={12} aria-hidden="true" />}
                  {link.label}
                </a>
              );
            })}
          </div>
        );
      })
    }
    <button
      type="button"
      data-scroll-to-top
      class="col-span-2 flex items-center justify-end gap-1 px-4 text-2xs font-semibold tracking-wider text-muted-foreground uppercase transition-colors duration-150 hover:text-foreground md:hidden"
    >
      Back to top
      <ArrowUpIcon size={12} weight="bold" aria-hidden="true" />
    </button>
  </nav>
</footer>

<script>
	import { startScrollToTop } from "@lib/scroll-to-top";

	startScrollToTop();
</script>
