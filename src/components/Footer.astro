---
const links = [
  { label: "About", href: "/about" },
  { label: "Privacy", href: "/privacy" },
  { label: "Developers", href: "/developers" },
];
---

<footer
  class="fixed bottom-0 z-50 h-4 w-full border-t border-border bg-background text-foreground"
>
  <nav
    aria-label="Footer"
    class="mx-auto flex h-full w-full max-w-480 items-stretch justify-end"
  >
    {
      links.map((link, index) => (
        <a
          href={link.href}
          class:list={[
            "flex items-center px-3 text-2xs tracking-wider uppercase transition-colors duration-150",
            "hover:bg-foreground hover:text-background",
            index > 0 && "border-l border-foreground/20",
          ]}
        >
          {link.label}
        </a>
      ))
    }
  </nav>
</footer>
