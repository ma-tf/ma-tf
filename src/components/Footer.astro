---
import { ArrowUpIcon, BracketsCurlyIcon } from "@phosphor-icons/react";
import { exploreLinks } from "@lib/site-nav";
import { R2_PUBLIC_URL } from "astro:env/server";

const columns = [
  {
    title: "Explore",
    links: exploreLinks,
    mobileOnly: true,
  },
  {
    title: "Site",
    links: [
      { label: "About", href: "/about" },
      { label: "Contact", href: "/contact" },
      { label: "Privacy", href: "/privacy" },
    ],
  },
  {
    title: "Resources",
    links: [
      { label: "Developers", href: "/developers", icon: BracketsCurlyIcon },
    ],
  },
].filter((column) => column.links.length > 0);

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const chromeBottom = `${R2_PUBLIC_URL}/misc/bottomleftchrome.png`;
---

<footer
  class="static z-50 w-full overflow-x-clip text-foreground md:fixed md:bottom-0 md:h-4"
>
  <nav
    aria-label="Footer"
    class="relative mx-auto grid w-full grid-cols-2 gap-4 pt-4 pb-8 before:pointer-events-none before:absolute before:-bottom-4.5 before:-left-38.5 before:-z-1 before:drop-shadow-chrome before:content-none md:flex md:h-full md:flex-row-reverse md:items-stretch md:gap-0.5 md:py-0 md:before:content-(--chrome-bottom) after:pointer-events-none after:absolute after:-bottom-4.5 after:-right-37 after:-z-1 after:drop-shadow-chrome after:content-none md:after:content-(--chrome-bottom)"
    style={{ "--chrome-bottom": `url("${chromeBottom}")` }}
  >
    {
      columns.map((column, columnIndex) => {
        const isLast = columnIndex === columns.length - 1;
        const isMobileOnly = "mobileOnly" in column && column.mobileOnly;
        return (
          <div
            class:list={[
              "grid content-start gap-4 px-4",
              isMobileOnly ? "md:hidden" : "md:flex md:gap-0.5 md:px-0",
              isLast && "md:me-auto",
            ]}
          >
            <span class="pt-1 pb-2 text-2xs font-semibold tracking-wider text-foreground uppercase md:hidden">
              {column.title}
            </span>
            {column.links.map((link) => {
              const isCurrent = link.href === currentPath;
              const Icon = "icon" in link ? link.icon : undefined;
              return (
                <a
                  href={link.href}
                  aria-current={isCurrent ? "page" : undefined}
                  class:list={[
                    "flex items-center gap-1 py-1 text-xs tracking-wider uppercase transition-colors duration-150 md:bg-background/15 md:hover:bg-background/50 md:inset-shadow-chip md:rounded-t-xs md:px-3 md:pb-0 md:pt-0.5 md:text-2xs md:dark:bg-white/15 md:dark:hover:bg-white/50",
                    "text-muted-foreground hover:text-foreground aria-[current=page]:text-foreground",
                  ]}
                >
                  {Icon && <Icon size={12} aria-hidden="true" />}
                  {link.label}
                </a>
              );
            })}
          </div>
        );
      })
    }
    <button
      type="button"
      data-scroll-to-top
      class="col-span-2 flex items-center justify-end gap-1 px-4 text-2xs font-semibold tracking-wider text-muted-foreground uppercase transition-colors duration-150 hover:text-foreground md:hidden"
    >
      Back to top
      <ArrowUpIcon size={12} weight="bold" aria-hidden="true" />
    </button>
  </nav>
</footer>

<script>
  import { startScrollToTop } from "@lib/scroll-to-top";

  startScrollToTop();
</script>
