---
const links = [
  { label: "About", href: "/about" },
  { label: "Privacy", href: "/privacy" },
  { label: "Developers", href: "/developers" },
];
---

<footer
  class="fixed bottom-0 z-50 flex h-8 w-full items-center border-t border-border bg-background px-8"
>
  <nav
    aria-label="Footer"
    class="mx-auto flex w-full max-w-480 items-center justify-end gap-6"
  >
    {
      links.map((link) => (
        <a
          href={link.href}
          class="text-sm text-muted-foreground underline-offset-4 hover:text-foreground hover:underline"
        >
          {link.label}
        </a>
      ))
    }
  </nav>
</footer>
