---
const leftLinks = [{ label: "Developers", href: "/developers" }];

const rightLinks = [
  { label: "About", href: "/about" },
  { label: "Contact", href: "/contact" },
  { label: "Privacy", href: "/privacy" },
];

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<footer
  class="fixed bottom-0 z-50 h-4 w-full border-t border-border bg-background text-foreground"
>
  <nav
    aria-label="Footer"
    class="mx-auto flex h-full w-full max-w-480 items-stretch"
  >
    {
      leftLinks.map((link) => {
        const isCurrent = link.href === currentPath;
        return (
          <a
            href={link.href}
            aria-current={isCurrent ? "page" : undefined}
            class:list={[
              "flex items-center px-3 text-2xs tracking-wider uppercase transition-colors duration-150",
              "text-muted-foreground hover:text-foreground aria-[current=page]:text-foreground",
            ]}
          >
            {link.label}
          </a>
        );
      })
    }
    <div class="ms-auto flex items-stretch">
      {
        rightLinks.map((link, index) => {
          const isCurrent = link.href === currentPath;
          return (
            <a
              href={link.href}
              aria-current={isCurrent ? "page" : undefined}
              class:list={[
                "flex items-center px-3 text-2xs tracking-wider uppercase transition-colors duration-150",
                "text-muted-foreground hover:text-foreground aria-[current=page]:text-foreground",
                index > 0 && "border-l border-foreground/20",
              ]}
            >
              {link.label}
            </a>
          );
        })
      }
    </div>
  </nav>
</footer>
