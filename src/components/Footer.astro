---
const links = [
  { label: "About", href: "/about" },
  { label: "Privacy", href: "/privacy" },
  { label: "Developers", href: "/developers" },
];

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<footer
  class="fixed bottom-0 z-50 h-4 w-full border-t border-border bg-background text-foreground"
>
  <nav
    aria-label="Footer"
    class="mx-auto flex h-full w-full max-w-480 items-stretch justify-end"
  >
    {
      links.map((link, index) => {
        const isCurrent = link.href === currentPath;
        return (
          <a
            href={link.href}
            aria-current={isCurrent ? "page" : undefined}
            class:list={[
              "flex items-center px-3 text-2xs tracking-wider uppercase transition-colors duration-150",
              "text-muted-foreground hover:text-foreground aria-[current=page]:text-foreground",
              index > 0 && "border-l border-foreground/20",
            ]}
          >
            {link.label}
          </a>
        );
      })
    }
  </nav>
</footer>
