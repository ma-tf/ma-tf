---
import Footer from "@components/Footer.astro";
import Header from "@components/Header.astro";
import { getCollection } from "astro:content";
import { mcpPath, resourceByRel } from "@features/discovery/catalog";
import { askEnabled } from "@lib/feature-flags";
import { AskTool } from "@features/faq/ask-tool";
import {
	pageDescriptionFor,
	pageNameFor,
	siteIdentity,
	siteJsonLd,
} from "@features/seo/site-metadata";

import "../styles/global.css";

const {
  title,
  description,
  hideOverflow = false,
  showHeader = true,
  showFooter = true,
} = Astro.props;

const siteUrl = Astro.site ?? new URL("https://m4t.tf");
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const markdownPath =
	Astro.url.pathname === "/" ? "/index.md" : `${Astro.url.pathname.replace(/\/+$/, "")}.md`;
const markdownUrl = new URL(markdownPath, siteUrl).href;
const ard = resourceByRel("ard");
const agentSkills = resourceByRel("agent-skills");
const ogImage = new URL(
	siteIdentity.ogImagePath,
	`${import.meta.env.R2_PUBLIC_URL}/`,
);
const faqAnswers =
	Astro.url.pathname === "/"
		? (await getCollection("faq"))
				.sort((a, b) => a.data.order - b.data.order)
				.map((entry) => ({
					question: entry.data.question,
					text: entry.body ?? "",
				}))
		: [];
const jsonLd = siteJsonLd(ogImage.href, Astro.url.pathname, faqAnswers);
const pageName = title ?? pageNameFor(Astro.url.pathname);
const pageTitle =
	Astro.url.pathname === "/"
		? siteIdentity.homeTitle
		: pageName
			? `${pageName} | ${siteIdentity.name}`
			: `${siteIdentity.name} | ${siteIdentity.jobTitle}`;
const pageDescription =
	description ?? pageDescriptionFor(Astro.url.pathname) ?? siteIdentity.description;
---

<script is:inline>
	const stored = localStorage.getItem("theme");
	const isDark = stored === "dark";
	document.documentElement.classList[isDark ? "add" : "remove"]("dark");
</script>

<script is:inline>
	const readVisited = () => {
		try {
			const stored = JSON.parse(sessionStorage.getItem("visited-pages") || "[]");
			return Array.isArray(stored) ? stored : [];
		} catch {
			return [];
		}
	};
	const writeVisited = (value) => {
		try {
			sessionStorage.setItem("visited-pages", JSON.stringify(value));
		} catch {
			return false;
		}
		return true;
	};
	const path = location.pathname.replace(/\/+$/, "") || "/";
	const visited = readVisited();
	if (visited.includes(path)) {
		document.documentElement.dataset.motion = "revisit";
	} else {
		writeVisited([...visited, path]);
	}
</script>

<script>
	import { startParallax } from "@lib/parallax";
	import { startReveal } from "@lib/reveal";
	import { startTypewriter } from "@lib/typewriter";

	startParallax();
	startReveal();
	startTypewriter();
</script>

<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="color-scheme" content="light dark" />
		<title>{pageTitle}</title>
		<meta name="description" content={pageDescription} />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="alternate" type="text/markdown" href={markdownUrl} />
		<link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
		<link rel="ard" href={ard.path} type={ard.type} />
		<link rel="agent-skills" href={agentSkills.path} type={agentSkills.type} />
		{askEnabled && <link rel="mcp" href={mcpPath} />}
		<meta property="og:type" content="website" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={pageDescription} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={ogImage.href} />
		<meta
			property="og:image:alt"
			content={`${siteIdentity.name}'s portfolio`}
		/>
		<meta property="og:image:width" content="640" />
		<meta property="og:image:height" content="480" />
		<meta property="og:site_name" content={siteIdentity.name} />
		<meta property="og:locale" content="en_GB" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="is-agentic-site-type" content="content" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<script
			is:inline
			type="application/ld+json"
			set:html={JSON.stringify(jsonLd)}
		/>
	</head>
	<body
		class:list={[
			"flex min-h-dvh flex-col bg-background text-foreground",
			{ "overflow-hidden": hideOverflow },
		]}
	>
		{showHeader && <Header />}
		<slot />
		{askEnabled && <AskTool client:only="react" />}
		{showFooter && <Footer />}
	</body>
</html>
