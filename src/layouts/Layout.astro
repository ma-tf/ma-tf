---
import "../styles/global.css";

const { hideOverflow = false } = Astro.props;

const siteUrl = Astro.site ?? new URL("https://m4t.tf");
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
---

<script is:inline>
	const stored = localStorage.getItem("theme");
	const isDark = stored === "dark";
	document.documentElement.classList[isDark ? "add" : "remove"]("dark");
</script>

<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="color-scheme" content="light dark" />
		<title>Matt F | Full-stack developer</title>
		<meta
			name="description"
			content="Personal portfolio and work of Matt F, a full-stack developer."
		/>
		<link rel="canonical" href={canonicalUrl} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content="Matt F | Full-stack developer" />
		<meta
			property="og:description"
			content="Personal portfolio and work of Matt F, a full-stack developer."
		/>
		<meta property="og:url" content={canonicalUrl} />
		<meta
			property="og:image"
			content={new URL("graphics/old house.png", `${import.meta.env.R2_PUBLIC_URL}/`).href}
		/>
		<meta property="og:image:alt" content="Matt F's portfolio" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<script is:inline type="application/ld+json">
			{
				"@context": "https://schema.org",
				"@type": "Person",
				"name": "Matt F",
				"description": "Personal portfolio and work of Matt F, a full-stack developer.",
				"url": "https://m4t.tf",
				"email": "admin@m4t.tf",
				"jobTitle": "Full-stack developer"
			}
		</script>
	</head>
	<body class:list={["flex min-h-dvh flex-col bg-background text-foreground", { "overflow-hidden": hideOverflow }]}>
		<slot />
	</body>
</html>
