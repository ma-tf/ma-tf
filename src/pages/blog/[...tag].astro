---
import Layout from "@layouts/Layout.astro";
import { TagContent } from "@features/tags/tag-content";
import { getTagIndex } from "@features/tags/tag-data";
import { CDN_BASE } from "@lib/cdn";

export async function getStaticPaths() {
  const { tags } = await getTagIndex();

  return [
    { params: { tag: undefined } },
    ...tags.map(({ tag }) => ({ params: { tag } })),
  ];
}

const data = await getTagIndex();
const { tags, postsByTag, allPosts } = data;
const selected = data.tags.find(({ tag }) => tag === Astro.params.tag) ?? null;
---

<Layout
  hideOverflow
  title={selected ? `Posts tagged ${selected.tag}` : "Blog"}
  description={
    selected
      ? `Writing tagged ${selected.tag} on the m4t.tf blog.`
      : "Every topic covered by writing on the m4t.tf blog."
  }
>
  <div
    class="absolute inset-0 -z-10 bg-emerald-50 dark:bg-emerald-950"
    aria-hidden="true"
  ></div>
  <TagContent
    backgroundBaseUrl={CDN_BASE}
    tags={tags}
    selected={selected}
    postsByTag={postsByTag}
    allPosts={allPosts}
    client:load
  />
</Layout>
