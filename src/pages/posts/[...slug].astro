---
import Layout from "@layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import { getRawPosts } from "@features/blog/post-data";
import { proseComponents } from "@components/prose";
import { Post } from "@features/posts/post";
import PostBirdBreak from "@features/posts/post-bird-break.astro";

export async function getStaticPaths() {
  const posts = await getRawPosts();

  return posts.map((post) => ({ params: { slug: post.data.slug } }));
}

const post = (await getCollection("blog")).find(
  (entry) => entry.data.slug === Astro.params.slug && !entry.data.draft,
);

if (!post) return new Response(null, { status: 404 });

const { Content, remarkPluginFrontmatter } = await render(post);
---

<Layout title={post.data.title} description={post.data.description}>
  <Post
    client:idle
    title={post.data.title}
    publicationDate={post.data.publicationDate}
    words={remarkPluginFrontmatter.words}
    minutesRead={remarkPluginFrontmatter.minutesRead}
    tags={post.data.tags}
  >
    <Content components={{ ...proseComponents, PostBirdBreak }} />
  </Post>
</Layout>

<script>
  import "@mux/mux-video";
</script>
