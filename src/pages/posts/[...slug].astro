---
import Layout from "@layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import { ClockIcon, FileTextIcon } from "@phosphor-icons/react";
import Navbar from "@components/Navbar.astro";
import { NavButton } from "@components/nav-button";
import {
  Post,
  PostContent,
  PostDate,
  PostHeader,
  PostTag,
  PostTags,
  PostTitle,
} from "@features/posts/post";
import { postComponents } from "@features/posts/post-content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.data.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(post);
---

<Layout>
  <Navbar />
  <Post>
    <div>
      <NavButton href="/blog" variant="outline">Blog</NavButton>
    </div>
    <PostHeader>
      <PostTitle>{post.data.title}</PostTitle>
      <div
        class="mb-4 flex flex-wrap items-center gap-2 text-sm text-muted-foreground"
      >
        <PostDate dateTime={post.data.pubDate.toISOString()}>
          {post.data.pubDate.toISOString().split("T")[0]}
        </PostDate>
        <span aria-hidden="true">·</span>
        <span class="inline-flex items-center gap-1">
          <FileTextIcon size={14} aria-hidden="true" />
          {remarkPluginFrontmatter.words} words
        </span>
        <span aria-hidden="true">·</span>
        <span class="inline-flex items-center gap-1">
          <ClockIcon size={14} aria-hidden="true" />
          {remarkPluginFrontmatter.minutesRead}
        </span>
      </div>
      {
        post.data.tags.length > 0 && (
          <PostTags>
            {post.data.tags.map((tag) => (
              <PostTag href={`/tags/${tag}`}>{tag}</PostTag>
            ))}
          </PostTags>
        )
      }
    </PostHeader>
    <PostContent>
      <Content components={postComponents} />
    </PostContent>
  </Post>
</Layout>

<script>
  import "@mux/mux-video";
</script>
