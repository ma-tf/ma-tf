---
import Layout from "@layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import { ClockIcon, FileTextIcon, HashIcon } from "@phosphor-icons/react";
import { NavButton } from "@components/nav-button";
import { Pill } from "@components/pill";
import { proseComponents } from "@components/prose";
import {
  Post,
  PostContent,
  PostDate,
  PostHeader,
  PostTitle,
} from "@features/posts/post";
import { R2_PUBLIC_URL } from "astro:env/server";
import { PostBird } from "@features/posts/post-bird";

const post = (await getCollection("blog")).find(
  (entry) => entry.data.slug === Astro.params.slug && !entry.data.draft,
);

if (!post) return new Response(null, { status: 404 });

const { Content, remarkPluginFrontmatter } = await render(post);
---

<Layout title={post.data.title} description={post.data.description}>
  <Post className="relative pt-20">
    <div
      class="mb-8 h-30 w-full overflow-hidden border border-foreground bg-muted"
    >
      <img
        src={`${R2_PUBLIC_URL}/blog/sats2-540-crop.webp`}
        alt="Two satellite dishes on a desert ridge beneath a hazy orange sky."
        width="540"
        height="127"
        fetchpriority="high"
        class="h-30 w-full animate-fade-in object-cover"
      />
    </div>
    <div>
      <NavButton href="/blog" variant="outline" className="animate-fade-up"
        >Blog</NavButton
      >
    </div>
    <PostHeader>
      <PostTitle className="animation-delay-50">{post.data.title}</PostTitle>
      <div
        class="mb-4 flex animate-fade-up animation-delay-100 flex-wrap items-center gap-2 text-sm text-muted-foreground"
      >
        <PostDate dateTime={post.data.publicationDate.toISOString()}>
          {post.data.publicationDate.toISOString().split("T")[0]}
        </PostDate>
        <span aria-hidden="true">·</span>
        <span class="inline-flex items-center gap-1">
          <FileTextIcon size={14} aria-hidden="true" />
          {remarkPluginFrontmatter.words} words
        </span>
        <span aria-hidden="true">·</span>
        <span class="inline-flex items-center gap-1">
          <ClockIcon size={14} aria-hidden="true" />
          {remarkPluginFrontmatter.minutesRead}
        </span>
      </div>
      {
        post.data.tags.length > 0 && (
          <ul class="animate-fade-up animation-delay-150 flex flex-wrap gap-2">
            {post.data.tags.map((tag) => (
              <li>
                <Pill href={`/tags/${tag}`}>
                  <span class="inline-flex items-center gap-0 pr-2">
                    <HashIcon size={14} className="shrink-0" />
                    {tag}
                  </span>
                </Pill>
              </li>
            ))}
          </ul>
        )
      }
    </PostHeader>
    <PostContent>
      <Content components={proseComponents} />
    </PostContent>
    <img
      src={`${R2_PUBLIC_URL}/blog/pencil-and-rubber-128.webp`}
      alt=""
      width="128"
      height="82"
      aria-hidden="true"
      class="mt-12 ml-auto w-16 dark:invert"
    />
    <PostBird
      src={`${R2_PUBLIC_URL}/blog/bird-80.webp`}
      audioSrc={`${R2_PUBLIC_URL}/blog/bird.ogg`}
      client:visible
    />
  </Post>
</Layout>

<script>
  import "@mux/mux-video";
</script>
