---
import Layout from "@layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import { ClockIcon, FileTextIcon, HashIcon } from "@phosphor-icons/react";
import { NavButton } from "@components/nav-button";
import { Pill } from "@components/pill";
import {
  Post,
  PostContent,
  PostDate,
  PostHeader,
  PostTitle,
} from "@features/posts/post";
import { postComponents } from "@features/posts/post-content";

const post = (await getCollection("blog")).find(
  (entry) => entry.data.slug === Astro.params.slug && !entry.data.draft,
);

if (!post) return new Response(null, { status: 404 });

const { Content, remarkPluginFrontmatter } = await render(post);
---

<Layout title={post.data.title}>
  <Post>
    <div>
      <NavButton href="/blog" variant="outline" className="animate-fade-up">Blog</NavButton>
    </div>
    <PostHeader>
      <PostTitle className="animation-delay-50">{post.data.title}</PostTitle>
      <div
        class="mb-4 flex animate-fade-up animation-delay-100 flex-wrap items-center gap-2 text-sm text-muted-foreground"
      >
        <PostDate dateTime={post.data.publicationDate.toISOString()}>
          {post.data.publicationDate.toISOString().split("T")[0]}
        </PostDate>
        <span aria-hidden="true">·</span>
        <span class="inline-flex items-center gap-1">
          <FileTextIcon size={14} aria-hidden="true" />
          {remarkPluginFrontmatter.words} words
        </span>
        <span aria-hidden="true">·</span>
        <span class="inline-flex items-center gap-1">
          <ClockIcon size={14} aria-hidden="true" />
          {remarkPluginFrontmatter.minutesRead}
        </span>
      </div>
      {
        post.data.tags.length > 0 && (
          <ul class="animate-fade-up animation-delay-150 flex flex-wrap gap-2">
            {post.data.tags.map((tag) => (
              <li>
                <Pill href={`/tags/${tag}`}>
                  <span class="inline-flex items-center gap-0 pr-2">
                    <HashIcon size={14} className="shrink-0" />
                    {tag}
                  </span>
                </Pill>
              </li>
            ))}
          </ul>
        )
      }
    </PostHeader>
    <PostContent>
      <Content components={postComponents} />
    </PostContent>
  </Post>
</Layout>

<script>
  import "@mux/mux-video";
</script>
