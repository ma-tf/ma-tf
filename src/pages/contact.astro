---
import Layout from "@layouts/Layout.astro";
import { StillLifeBackground } from "@components/still-life-background";
import {
  Contact,
  ContactCard,
  ContactContent,
  ContactHeader,
  ContactTitle,
} from "@features/contact/contact";
---

<Layout>
  <div class="relative w-full self-center max-w-480 overflow-hidden border-l">
    <StillLifeBackground baseUrl={`${import.meta.env.R2_PUBLIC_URL}/about`} />
    <Contact>
      <ContactHeader>
        <ContactTitle>Contact</ContactTitle>
      </ContactHeader>
      <ContactContent>
        <section class="text-xs flex gap-8 pb-64 pl-16" data-parallax={40}>
          <ContactCard data-parallax={3}>
            <p
              class="p-2 animate-fade-up animation-delay-1050"
              data-parallax={10}
            >
              Email me at <a
                href="mailto:admin@m4t.tf"
                class="underline underline-offset-4 hover:text-foreground/70"
                >admin@m4t.tf</a
              > about my work, projects, or professional experience.
            </p>
          </ContactCard>
          <ContactCard data-parallax={5}>
            <p
              class="p-2 animate-fade-up animation-delay-1100"
              data-parallax={17}
            >
              For verified facts about my background, see my <a
                href="/cv"
                class="underline underline-offset-4 hover:text-foreground/70">CV</a
              >. It lists my experience, skills, education, and projects.
            </p>
          </ContactCard>
          <ContactCard data-parallax={7}>
            <p
              class="p-2 animate-fade-up animation-delay-1150"
              data-parallax={23}
            >
              My software projects and open-source work live on <a
                href="https://github.com/ma-tf"
                rel="noreferrer"
                class="underline underline-offset-4 hover:text-foreground/70"
                >GitHub</a
              >.
            </p>
          </ContactCard>
        </section>
      </ContactContent>
    </Contact>
  </div>
</Layout>
