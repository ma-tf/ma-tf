---
import Layout from "@layouts/Layout.astro";
import { StillLifeBackground } from "@components/still-life-background";
import {
  Contact,
  ContactCard,
  ContactContent,
  ContactHeader,
  ContactScrollCue,
  ContactTitle,
} from "@features/contact/contact";
---

<Layout>
  <div class="relative w-full self-center max-w-480 md:overflow-hidden border-l">
    <Contact>
      <StillLifeBackground
        baseUrl={`${import.meta.env.R2_PUBLIC_URL}/about`}
        scrollDistance={1.5}
        scrollDrift={0.4}
        scrollScale={1.15}
        className="sticky top-0 col-start-1 row-start-1 h-lvh"
      />
      <ContactHeader>
        <ContactTitle>Contact</ContactTitle>
        <ContactScrollCue />
      </ContactHeader>
      <ContactContent>
        <section
          class="text-base leading-relaxed flex flex-col gap-12 pb-36 pt-12 md:flex-row md:gap-9 md:pb-64 md:pl-16 md:text-xs"
          data-parallax={40}
        >
          <ContactCard className="animate-reveal">
            <p
              class="p-2 md:animate-fade-up md:animation-delay-1050"
              data-parallax={10}
            >
              Email me at <a
                href="mailto:admin@m4t.tf"
                class="underline underline-offset-4 hover:text-foreground/70"
                >admin@m4t.tf</a
              > about my work, projects, or professional experience.
            </p>
          </ContactCard>
          <ContactCard className="animate-reveal">
            <p
              class="p-2 md:animate-fade-up md:animation-delay-1100"
              data-parallax={17}
            >
              For verified facts about my background, see my <a
                href="/cv"
                class="underline underline-offset-4 hover:text-foreground/70">CV</a
              >. It lists my experience, skills, education, and projects.
            </p>
          </ContactCard>
          <ContactCard className="animate-reveal">
            <p
              class="p-2 md:animate-fade-up md:animation-delay-1150"
              data-parallax={23}
            >
              My software projects and open-source work live on <a
                href="https://github.com/ma-tf"
                rel="noreferrer"
                class="underline underline-offset-4 hover:text-foreground/70"
                >GitHub</a
              >.
            </p>
          </ContactCard>
        </section>
      </ContactContent>
    </Contact>
  </div>
</Layout>
