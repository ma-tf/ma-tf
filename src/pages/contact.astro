---
import Layout from "@layouts/Layout.astro";
import { Link } from "@components/link";
import { ArrowSquareOutIcon } from "@phosphor-icons/react";
import { StillLifeBackground } from "@components/still-life-background";
import { stillLifeScroll, stillLifeSectionClass } from "@components/still-life-hero";
import { ScrollCue } from "@components/scroll-cue";
import {
  Contact,
  ContactCard,
  ContactContent,
  ContactHeader,
  ContactTitle,
} from "@features/contact/contact";
import { R2_PUBLIC_URL } from "astro:env/server";
---

<Layout>
  <div class="relative w-full self-center max-w-480 md:overflow-hidden border-l">
    <Contact>
      <StillLifeBackground
        baseUrl={`${R2_PUBLIC_URL}/about`}
        {...stillLifeScroll}
        className="sticky top-0 col-start-1 row-start-1 h-lvh"
      />
      <ContactHeader>
        <ContactTitle>Contact</ContactTitle>
        <ScrollCue />
      </ContactHeader>
      <ContactContent>
        <section
          class:list={[stillLifeSectionClass, "md:text-xs"]}
          data-parallax={40}
          data-parallax-scroll
          data-parallax-scroll-distance={2}
          data-parallax-scroll-drift={0.1}
        >
          <ContactCard className="animate-reveal md:opacity-100 md:transform-none">
            <p
              class="p-4 md:p-2 md:animate-fade-up md:animation-delay-1050"
              data-parallax={10}
            >
              Email me at <Link href="mailto:admin@m4t.tf">admin@m4t.tf</Link> about my work,
              projects, or professional experience.
            </p>
          </ContactCard>
          <ContactCard className="animate-reveal md:opacity-100 md:transform-none">
            <p
              class="p-4 md:p-2 md:animate-fade-up md:animation-delay-1100"
              data-parallax={17}
            >
              For verified facts about my background, see my <Link
                href="/cv"
                className="inline-flex items-center gap-1"
              >
                CV
                <ArrowSquareOutIcon className="size-3 shrink-0" aria-hidden="true" />
              </Link>. It lists my experience, skills, education, and projects.
            </p>
          </ContactCard>
          <ContactCard className="animate-reveal md:opacity-100 md:transform-none">
            <p
              class="p-4 md:p-2 md:animate-fade-up md:animation-delay-1150"
              data-parallax={23}
            >
              My software projects and open-source work live on <Link
                href="https://github.com/ma-tf"
                rel="noreferrer"
                className="inline-flex items-center gap-1"
              >
                GitHub
                <ArrowSquareOutIcon className="size-3 shrink-0" aria-hidden="true" />
              </Link>.
            </p>
          </ContactCard>
        </section>
      </ContactContent>
    </Contact>
  </div>
</Layout>
