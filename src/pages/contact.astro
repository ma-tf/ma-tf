---
import Layout from "@layouts/Layout.astro";
import { Link } from "@components/link";
import { ArrowSquareOutIcon } from "@phosphor-icons/react";
import { StillLifeCard } from "@components/still-life-hero";
import StillLifePage from "@components/still-life-page.astro";
import { ContactTitle } from "@features/contact/contact";
import { R2_PUBLIC_URL } from "astro:env/server";
---

<Layout>
  <StillLifePage baseUrl={`${R2_PUBLIC_URL}/about`}>
    <Fragment slot="title"><ContactTitle>Contact</ContactTitle></Fragment>
    <StillLifeCard
      data-parallax={10}
      className="animate-reveal md:opacity-100 md:transform-none md:animate-fade-in md:animation-delay-2000"
    >
      <p
        data-parallax={5}
        class="p-4 md:p-2 md:animate-fade-up md:animation-delay-2300"
      >
        Email me at <Link href="mailto:admin@m4t.tf">admin@m4t.tf</Link> about my
        work, projects, or professional experience.
      </p>
    </StillLifeCard>
    <StillLifeCard
      data-parallax={15}
      className="animate-reveal md:opacity-100 md:transform-none md:animate-fade-in md:animation-delay-2150"
    >
      <p
        data-parallax={10}
        class="p-4 md:p-2 md:animate-fade-up md:animation-delay-2450"
      >
        For verified facts about my background, see my <Link
          href="/cv"
          className="inline-flex items-center gap-1"
        >
          CV
          <ArrowSquareOutIcon className="size-3 shrink-0" aria-hidden="true" />
        </Link>. It lists my experience, skills, education, and projects.
      </p>
    </StillLifeCard>
    <StillLifeCard
      data-parallax={20}
      className="animate-reveal md:opacity-100 md:transform-none md:animate-fade-in md:animation-delay-2300"
    >
      <p
        data-parallax={15}
        class="p-4 md:p-2 md:animate-fade-up md:animation-delay-2600"
      >
        My software projects and open-source work live on <Link
          href="https://github.com/ma-tf"
          rel="noreferrer"
          className="inline-flex items-center gap-1"
        >
          GitHub
          <ArrowSquareOutIcon className="size-3 shrink-0" aria-hidden="true" />
        </Link>.
      </p>
    </StillLifeCard>
  </StillLifePage>
</Layout>
