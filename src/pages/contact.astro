---
import Layout from "@layouts/Layout.astro";
import Navbar from "@components/Navbar.astro";
---

<Layout>
  <Navbar />
  <div
    class="mx-auto min-h-screen max-w-3xl px-4 py-16 text-foreground md:px-8"
  >
    <h1 class="mb-6 text-4xl font-semibold">Contact</h1>
    <div class="flex flex-col gap-8 text-lg leading-relaxed">
      <p>
        For enquiries about my work, projects, or professional experience, email
        <a
          href="mailto:admin@m4t.tf"
          class="underline underline-offset-4 hover:text-foreground/70">admin@m4t.tf</a>.
      </p>
      <p>
        My software projects and open-source work are available on
        <a
          href="https://github.com/ma-tf"
          rel="noreferrer"
          class="underline underline-offset-4 hover:text-foreground/70">GitHub</a>.
      </p>
    </div>
  </div>
</Layout>
