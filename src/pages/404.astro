---
import Layout from "@layouts/Layout.astro";
import Navbar from "@components/Navbar.astro";
---

<Layout>
  <Navbar />
  <main class="mx-auto min-h-screen max-w-3xl px-4 py-16 text-foreground md:px-8">
    <h1 class="mb-4 text-4xl font-semibold">Page not found</h1>
    <p class="mb-6">That page does not exist. Try the homepage, the site guide, or the sitemap.</p>
    <nav class="flex flex-wrap gap-4">
      <a class="underline" href="/">Home</a>
      <a class="underline" href="/llms.txt">Agent guide</a>
      <a class="underline" href="/sitemap-index.xml">Sitemap</a>
    </nav>
  </main>
</Layout>
