---
import Layout from "@layouts/Layout.astro";
import { Link } from "@components/link";
---

<Layout
  title="Page not found"
  description="No page exists at this address; the site guide and developer docs list everything m4t.tf publishes."
>
  <div class="mx-auto min-h-screen max-w-3xl px-4 py-16 text-foreground md:px-8">
    <h1 class="mb-4 animate-fade-up text-4xl font-semibold">Page not found</h1>
    <p class="mb-6 animate-fade-up animation-delay-50">
      That page does not exist. The site guide lists every published page and the files
      published for agents, and the developer docs describe the machine-readable interface.
    </p>
    <nav class="flex animate-fade-up animation-delay-100 flex-wrap gap-4">
      <Link href="/">Home</Link>
      <Link href="/llms.txt">Agent guide</Link>
      <Link href="/developers">Developer docs</Link>
      <Link href="/sitemap.xml">Sitemap</Link>
    </nav>
  </div>
</Layout>
