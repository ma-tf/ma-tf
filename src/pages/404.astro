---
import Layout from "@layouts/Layout.astro";
---

<Layout title="Page not found">
  <main class="mx-auto min-h-screen max-w-3xl px-4 py-16 text-foreground md:px-8">
    <h1 class="mb-4 animate-fade-up text-4xl font-semibold">Page not found</h1>
    <p class="mb-6 animate-fade-up animation-delay-50">
      That page does not exist. The site guide lists every published page and the files
      published for agents, and the developer docs describe the machine-readable interface.
    </p>
    <nav class="flex animate-fade-up animation-delay-100 flex-wrap gap-4">
      <a class="underline" href="/">Home</a>
      <a class="underline" href="/llms.txt">Agent guide</a>
      <a class="underline" href="/developers">Developer docs</a>
      <a class="underline" href="/sitemap.xml">Sitemap</a>
    </nav>
  </main>
</Layout>
