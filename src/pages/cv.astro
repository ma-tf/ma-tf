---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import ExperienceSection from "@features/cv/experience.astro";
import EducationSection from "@features/cv/education.astro";
import ProjectsSection from "@features/cv/projects.astro";
import profile from "@content/profile.json";
import {
	EnvelopeSimpleIcon,
	GithubLogoIcon,
	LinkedinLogoIcon,
} from "@phosphor-icons/react";
import {
	CurriculumVitaeContact,
	CurriculumVitaeContactLink,
	CurriculumVitaeName,
	CurriculumVitaeRole,
	CurriculumVitaeSection,
	CurriculumVitaeSkill,
	CurriculumVitaeStrength,
	CurriculumVitaeStrengths,
	CurriculumVitaeStrengthsLabel,
	CurriculumVitaeTitle,
} from "@features/cv/cv";

const skills = (await getCollection("skills")).sort((a, b) => a.data.order - b.data.order);
---

<Layout>
	<div class="bg-muted min-h-dvh px-4 py-8 md:px-8">
		<div class="mx-auto flex w-full max-w-md flex-col gap-2 md:max-w-3xl">
			<CurriculumVitaeName>{profile.name}</CurriculumVitaeName>
			<CurriculumVitaeRole>{profile.title}</CurriculumVitaeRole>
			<CurriculumVitaeContact>
				<CurriculumVitaeContactLink href={`mailto:${profile.email}`}>
					<EnvelopeSimpleIcon className="size-3.5 shrink-0" aria-hidden="true" />
					{profile.email}
				</CurriculumVitaeContactLink>
				<CurriculumVitaeContactLink href={profile.github}>
					<GithubLogoIcon className="size-3.5 shrink-0" aria-hidden="true" />
					GitHub
				</CurriculumVitaeContactLink>
				<CurriculumVitaeContactLink href={profile.linkedin}>
					<LinkedinLogoIcon className="size-3.5 shrink-0" aria-hidden="true" />
					LinkedIn
				</CurriculumVitaeContactLink>
			</CurriculumVitaeContact>
			<div>
				<p>
					I started programming in 2013 for both education and for fun, and I
					began writing software professionally in 2018. My professional
					experience is in the sectors of public safety, finance, and
					intellectual property.
				</p>
			</div>
			<CurriculumVitaeStrengths>
				<CurriculumVitaeStrengthsLabel>Technical Strengths</CurriculumVitaeStrengthsLabel>
				{
					skills.map((group) => (
						<CurriculumVitaeStrength>
							{group.data.skills.map((skill) => (
								<CurriculumVitaeSkill>{skill}</CurriculumVitaeSkill>
							))}
						</CurriculumVitaeStrength>
					))
				}
			</CurriculumVitaeStrengths>
			<CurriculumVitaeSection>
				<CurriculumVitaeTitle>Experience</CurriculumVitaeTitle>
				<ExperienceSection />
			</CurriculumVitaeSection>
			<CurriculumVitaeSection>
				<CurriculumVitaeTitle>Projects</CurriculumVitaeTitle>
				<ProjectsSection />
			</CurriculumVitaeSection>
			<CurriculumVitaeSection>
				<CurriculumVitaeTitle>Education</CurriculumVitaeTitle>
				<EducationSection />
			</CurriculumVitaeSection>
		</div>
	</div>
</Layout>
