---
import Layout from "@layouts/Layout.astro";
import ExperienceSection from "@components/experience.astro";
import EducationSection from "@components/education.astro";
import profile from "@data/profile.json";
import { ModeToggle } from "@components/ModeToggle";
import { CurriculumVitaeSection, CurriculumVitaeTitle } from "@components/cv";
---

<Layout>
	<ModeToggle client:load />
	<div class="bg-muted min-h-screen px-4 py-8 md:px-8">
		<div class="mx-auto flex w-full max-w-md flex-col gap-2 md:max-w-3xl">
			<h1>{profile.name}</h1>
			<h2>{profile.title}</h2>
			<CurriculumVitaeSection>
				<CurriculumVitaeTitle>Experience</CurriculumVitaeTitle>
				<ExperienceSection />
			</CurriculumVitaeSection>
			<CurriculumVitaeSection>
				<CurriculumVitaeTitle>Projects</CurriculumVitaeTitle>
			</CurriculumVitaeSection>
			<CurriculumVitaeSection>
				<CurriculumVitaeTitle>Education</CurriculumVitaeTitle>
				<EducationSection />
			</CurriculumVitaeSection>
		</div>
	</div>
</Layout>
