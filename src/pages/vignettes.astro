---
import { getCollection } from "astro:content";

const firstVignette = (await getCollection("vignettes"))
  .filter(({ data }) => data.enabled)
  .sort((a, b) => a.data.order - b.data.order)
  .at(0);

if (!firstVignette) {
  return new Response("No enabled vignettes found", { status: 404 });
}

return Astro.redirect(`/vignettes/${firstVignette.data.slug}`);
---
