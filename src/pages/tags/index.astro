---
import Layout from "@layouts/Layout.astro";
import { ModeToggle } from "@components/ModeToggle";
import { TagOrbit } from "@features/tags/tag-orbit";
import { getTagIndex } from "@features/tags/tag-data";

const { tags, postsByTag } = await getTagIndex();
---

<Layout>
  <ModeToggle client:only="react" />
  <TagOrbit tags={tags} postsByTag={postsByTag} client:load />
</Layout>
