---
import Layout from "@layouts/Layout.astro";
import Navbar from "@components/Navbar.astro";
import { TagOrbit } from "@features/tags/tag-orbit";
import { ParallaxBackgrounds } from "@features/tags/parallax-backgrounds";
import { getTagIndex } from "@features/tags/tag-data";

const { tags, postsByTag } = await getTagIndex();
---

<Layout hideOverflow>
  <ParallaxBackgrounds client:load />
  <Navbar />
  <TagOrbit
    tags={tags}
    postsByTag={postsByTag}
    initialSelected=""
    client:load
  />
</Layout>
