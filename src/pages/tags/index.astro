---
import Layout from "@layouts/Layout.astro";
import Navbar from "@components/Navbar.astro";
import { TagContent } from "@features/tags/tag-content";
import { getTagIndex } from "@features/tags/tag-data";

const { tags, postsByTag } = await getTagIndex();
const selected = tags.find((t) => t.tag === "") ?? null;
---

<Layout hideOverflow>
  <Navbar />
  <TagContent
    tags={tags}
    selected={selected}
    postsByTag={postsByTag}
    client:load
  />
</Layout>
