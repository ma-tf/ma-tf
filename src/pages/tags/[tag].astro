---
import Layout from "@layouts/Layout.astro";
import { getRawPosts } from "@features/blog/post-data";
import Navbar from "@components/Navbar.astro";
import { TagOrbit } from "@features/tags/tag-orbit";
import { ParallaxBackgrounds } from "@features/tags/parallax-backgrounds";
import { getTagIndex } from "@features/tags/tag-data";

export async function getStaticPaths() {
  const posts = await getRawPosts();
  const tags = [...new Set(posts.flatMap((post) => post.data.tags))];

  return tags.map((tag) => ({
    params: { tag },
    props: { tag },
  }));
}

const { tag } = Astro.props;
const { tags, postsByTag } = await getTagIndex();
---

<Layout hideOverflow>
  <ParallaxBackgrounds client:load />
  <Navbar />
  <TagOrbit tags={tags} postsByTag={postsByTag} initialSelected={tag} client:load />
</Layout>