---
import Layout from "@layouts/Layout.astro";
import { getRawPosts } from "@features/blog/post-data";
import Navbar from "@components/Navbar.astro";
import { TagContent } from "@features/tags/tag-content";
import { getTagIndex } from "@features/tags/tag-data";

export async function getStaticPaths() {
  const posts = await getRawPosts();
  const tags = [...new Set(posts.flatMap((post) => post.data.tags))];

  return tags.map((tag) => ({
    params: { tag },
    props: { tag },
  }));
}

const { tag } = Astro.props;
const { tags, postsByTag } = await getTagIndex();
const selected = tags.find((t) => t.tag === tag) ?? null;
---

<Layout hideOverflow>
  <Navbar />
  <div class="absolute inset-0 -z-10" aria-hidden="true"></div>
  <TagContent
    tags={tags}
    selected={selected}
    postsByTag={postsByTag}
    client:load
  />
</Layout>
