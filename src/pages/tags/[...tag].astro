---
import Layout from "@layouts/Layout.astro";
import Navbar from "@components/Navbar.astro";
import { TagContent } from "@features/tags/tag-content";
import { getTagIndex } from "@features/tags/tag-data";

const data = await getTagIndex();
const { tags, postsByTag } = data;
const selected = data.tags.find(({ tag }) => tag === Astro.params.tag) ?? null;
const backgroundBaseUrl = import.meta.env.R2_PUBLIC_URL;
---

<Layout hideOverflow>
  <Navbar />
  <div
    class="absolute inset-0 -z-10 bg-emerald-50 dark:bg-emerald-950"
    aria-hidden="true"
  >
  </div>
  <TagContent
    backgroundBaseUrl={backgroundBaseUrl}
    tags={tags}
    selected={selected}
    postsByTag={postsByTag}
    client:load
  />
</Layout>
