---
import Layout from "@layouts/Layout.astro";
import { mcpPath } from "@features/discovery/catalog";
import {
  Developers,
  DevelopersCard,
  DevelopersContent,
  DevelopersHeader,
  DevelopersIntro,
  DevelopersResources,
  DevelopersTitle,
} from "@features/developers/developers";
import { askEnabled } from "@lib/feature-flags";
import { StillLifeBackground } from "@components/still-life-background";
import { stillLifeScroll } from "@components/still-life-hero";
import { ScrollCue } from "@components/scroll-cue";
import { askRateLimit } from "@lib/rate-limits";
---

<Layout
  title="m4t.tf developers"
  description="The machine-readable interface of m4t.tf: retrieval, errors, versioning, rate limits, and the MCP server."
>
  <div class="relative w-full self-center max-w-480 md:overflow-hidden border-l">
    <Developers>
      <StillLifeBackground
        baseUrl={`${import.meta.env.R2_PUBLIC_URL}/about`}
        {...stillLifeScroll}
        className="sticky top-0 col-start-1 row-start-1 h-lvh"
      />
      <DevelopersHeader>
        <DevelopersTitle>
          <span class="sr-only">m4t.tf </span>developers
        </DevelopersTitle>
        <ScrollCue />
        <DevelopersIntro>
          m4t.tf is machine-readable. Every page is served as HTML or markdown,
          and every resource below is an unauthenticated GET — there are no API
          keys.
          {
            askEnabled && (
              <>
                {" "}
                An MCP server is also published at{" "}
                <a
                  href={mcpPath}
                  class="underline underline-offset-4 hover:text-foreground/70"
                >
                  /mcp
                </a>
                .
              </>
            )
          }
        </DevelopersIntro>
      </DevelopersHeader>

      <DevelopersResources className="hidden md:block md:col-span-3 md:col-start-7 md:row-start-1 md:self-end animation-delay-2300" />

      <DevelopersContent>
        <DevelopersResources className="md:hidden" />

        <section
          data-parallax={40}
          class="text-base leading-relaxed flex flex-col gap-12 md:flex-row md:items-start md:gap-8 md:text-xs"
        >
          <DevelopersCard data-parallax={10} className="animation-delay-2450">
            <div class="relative flex flex-col px-2 pb-2 pt-4 leading-relaxed">
              <h2
                class="absolute left-2 top-0 -mt-2 text-xs font-semibold uppercase md:animate-fade-up md:animation-delay-3050"
              >
                Rate limits
              </h2>
              <p class="md:animate-fade-up md:animation-delay-3650">
                Every page and resource is unmetered.
                {
                  askEnabled && (
                    <>
                      {" "}
                      <code>POST /ask</code> and the <code>ask</code> tool on{" "}
                      <code>POST /mcp</code> are metered at{" "}
                      <code>{askRateLimit.quota}</code> requests per minute per
                      client and return <code>429 Too Many Requests</code> with{" "}
                      <code>Retry-After</code> once past it. Metered responses
                      carry <code>RateLimit</code>, <code>RateLimit-Policy</code>,{" "}
                      <code>RateLimit-Limit</code>,{" "}
                      <code>RateLimit-Remaining</code>, and{" "}
                      <code>RateLimit-Reset</code> headers; a{" "}
                      <code>429</code> adds <code>Retry-After</code>.
                    </>
                  )
                }
              </p>
            </div>
          </DevelopersCard>

          <DevelopersCard data-parallax={15} className="animation-delay-2600">
            <div class="relative flex flex-col px-2 pb-2 pt-4 leading-relaxed">
              <h2
                class="absolute left-2 top-0 -mt-2 text-xs font-semibold uppercase md:animate-fade-up md:animation-delay-3200"
              >
                Errors
              </h2>
              <p class="md:animate-fade-up md:animation-delay-3800">
                Failures follow your <code>Accept</code> header as{" "}
                <code>application/problem+json</code>, markdown, or HTML, and
                carry a stable <code>code</code> and <code>resolution</code>.
              </p>
            </div>
          </DevelopersCard>

          <DevelopersCard data-parallax={20} className="animation-delay-2750">
            <div class="relative flex flex-col px-2 pb-2 pt-4 leading-relaxed">
              <h2
                class="absolute left-2 top-0 -mt-2 text-xs font-semibold uppercase md:animate-fade-up md:animation-delay-3350"
              >
                Versioning
              </h2>
              <p class="md:animate-fade-up md:animation-delay-3950">
                Send <code>API-Version</code> to declare the compatibility version
                you expect; the current version is <code>1</code>. Deprecated
                resources carry <code>Deprecation</code> and <code>Sunset</code>{" "}
                headers until they retire.
              </p>
            </div>
          </DevelopersCard>
        </section>

        <p
          data-parallax={20}
          data-typewriter
          class="text-base leading-relaxed md:mb-8 md:text-xs md:animate-fade-up md:animation-delay-4100"
        >
          The OpenAPI 3.1 document at{" "}
          <a
            href="/openapi.json"
            class="underline underline-offset-4 hover:text-foreground/70"
            >/openapi.json</a
          > describes the whole interface, and{" "}
          <a
            href="/llms.txt"
            class="underline underline-offset-4 hover:text-foreground/70"
            >/llms.txt</a
          > indexes everything the site publishes.
        </p>
      </DevelopersContent>
    </Developers>
  </div>
</Layout>
