---
import Layout from "@layouts/Layout.astro";
import { mcpPath, resources } from "@features/discovery/catalog";
import {
  Developers,
  DevelopersCard,
  DevelopersContent,
  DevelopersHeader,
  DevelopersIntro,
  DevelopersTitle,
} from "@features/developers/developers";
import { askEnabled } from "@lib/feature-flags";
import { StillLifeBackground } from "@components/still-life-background";
import { askRateLimit } from "@lib/rate-limits";
---

<Layout>
  <div class="relative w-full self-center max-w-480 overflow-hidden border-l">
    <StillLifeBackground baseUrl={`${import.meta.env.R2_PUBLIC_URL}/about`} />
    <Developers>
      <DevelopersHeader>
        <DevelopersTitle>developers</DevelopersTitle>
        <DevelopersIntro>
          m4t.tf is machine-readable. Every page is served as HTML or markdown,
          and every resource below is an unauthenticated GET — there are no API
          keys.
          {
            askEnabled && (
              <>
                {" "}
                An MCP server is also published at{" "}
                <a
                  href={mcpPath}
                  class="underline underline-offset-4 hover:text-foreground/70"
                >
                  /mcp
                </a>
                .
              </>
            )
          }
        </DevelopersIntro>
      </DevelopersHeader>

      <DevelopersCard
        data-parallax={30}
        className="md:col-span-3 md:col-start-7 md:row-start-1 md:self-end"
      >
        <div
          data-parallax={10}
          class="relative flex flex-col px-2 pb-2 pt-4 text-xs leading-relaxed animate-fade-up animation-delay-50"
        >
          <h2
            class="absolute top-0 left-2 -translate-y-1/2 text-xs font-semibold uppercase"
          >
            Resources
          </h2>
          <ul class="flex flex-col gap-1.5">
            {
              resources.map((resource) => {
                const mediaType = resource.type.split(";")[0] ?? resource.type;

                return (
                  <li>
                    <a
                      href={resource.path}
                      class="underline underline-offset-4 hover:text-foreground/70"
                    >
                      {resource.path}
                    </a>
                    <span class="text-muted-foreground">
                      {" "}
                      — {mediaType} — {resource.title}
                    </span>
                  </li>
                );
              })
            }
          </ul>
        </div>
      </DevelopersCard>

      <DevelopersContent>
        <section
          data-parallax={40}
          class="text-xs flex items-start gap-8 pb-64 pl-16"
        >
          <DevelopersCard data-parallax={10}>
            <div
              class="relative flex flex-col px-2 pb-2 pt-4 leading-relaxed animate-fade-up animation-delay-50"
            >
              <h2
                class="absolute top-0 left-2 -translate-y-1/2 text-xs font-semibold uppercase"
              >
                Rate limits
              </h2>
              <p>
                Every page and resource is unmetered.
                {
                  askEnabled && (
                    <>
                      {" "}
                      <code>POST /ask</code> and the <code>ask</code> tool on{" "}
                      <code>POST /mcp</code> are metered at{" "}
                      <code>{askRateLimit.quota}</code> requests per minute per
                      client and return <code>429 Too Many Requests</code> with{" "}
                      <code>Retry-After</code> once past it.
                    </>
                  )
                }
              </p>
            </div>
          </DevelopersCard>

          <DevelopersCard data-parallax={15}>
            <div
              class="relative flex flex-col px-2 pb-2 pt-4 leading-relaxed animate-fade-up animation-delay-50"
            >
              <h2
                class="absolute top-0 left-2 -translate-y-1/2 text-xs font-semibold uppercase"
              >
                Errors
              </h2>
              <p>
                Failures follow your <code>Accept</code> header as{" "}
                <code>application/problem+json</code>, markdown, or HTML, and
                carry a stable <code>code</code> and <code>resolution</code>.
              </p>
            </div>
          </DevelopersCard>

          <DevelopersCard data-parallax={20}>
            <div
              class="relative flex flex-col px-2 pb-2 pt-4 leading-relaxed animate-fade-up animation-delay-50"
            >
              <h2
                class="absolute top-0 left-2 -translate-y-1/2 text-xs font-semibold uppercase"
              >
                Versioning
              </h2>
              <p>
                Send <code>API-Version</code> to declare the compatibility version
                you expect; the current version is <code>1</code>. Deprecated
                resources carry <code>Deprecation</code> and{" "}
                <code>Sunset</code> headers until they retire.
              </p>
            </div>
          </DevelopersCard>
        </section>
      </DevelopersContent>

      <p
        class="mb-8 text-xs leading-relaxed animate-fade-up animation-delay-50 md:col-span-9 md:col-start-2 md:row-start-3"
      >
        The OpenAPI 3.1 document at
        <a
          href="/openapi.json"
          class="underline underline-offset-4 hover:text-foreground/70"
          >/openapi.json</a
        > describes the whole interface, and
        <a
          href="/llms.txt"
          class="underline underline-offset-4 hover:text-foreground/70"
          >/llms.txt</a
        > indexes everything the site publishes.
      </p>
    </Developers>
  </div>
</Layout>
