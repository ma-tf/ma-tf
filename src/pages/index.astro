---
import { Home } from "@features/home/home";
import { BlogPreview } from "@features/blog/blog-preview";
import { ProjectsPreview } from "@features/projects/projects-preview";
import { PhotographyPreview } from "@features/photography/photography-preview";
import { VignettesPreview } from "@features/vignettes/vignettes-preview";
import { GraphicsPreview } from "@features/graphics/graphics-preview";
import { MusicPreview } from "@features/music/music-preview";
import { Faq } from "@features/faq/faq";
import Layout from "@layouts/Layout.astro";
import Navbar from "@components/Navbar.astro";
import { getPosts } from "@features/blog/post-data";
import { previews } from "@lib/feature-flags";
import type { ImageMap } from "@lib/images";

const allPosts = await getPosts();
const recentPosts = previews.blog ? allPosts.slice(0, 4) : [];

const r2 = import.meta.env.R2_PUBLIC_URL;

const images: ImageMap = {
  "vignettes/bolex-bg-dither.png": `${r2}/vignettes/bolex-bg-dither.png`,
  "vignettes/bolex-fg-dither-anon.png": `${r2}/vignettes/bolex-fg-dither-anon.png`,
  "graphics/old house.png": `${r2}/graphics/old%20house.webp`,
  "music/20251014_Japan 6_19.jpg": `${r2}/music/20251014_Japan%206_19.webp`,
};
---

<Layout>
  <Navbar />
  <Home />
  {previews.blog && <BlogPreview posts={recentPosts} />}
  {previews.projects && <ProjectsPreview />}
  {previews.photography && <PhotographyPreview />}
  {previews.vignettes && <VignettesPreview images={images} />}
  {previews.graphics && <GraphicsPreview images={images} />}
  {previews.music && <MusicPreview images={images} />}
  <Faq client:visible />
  <footer class="flex w-full max-w-480 justify-end px-8">
    <a
      href="/developers"
      class="text-sm text-muted-foreground underline-offset-4 hover:text-foreground hover:underline"
      >Developers</a
    >
  </footer>
</Layout>
