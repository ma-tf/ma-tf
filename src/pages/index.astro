---
import { Home } from "@components/home";
import { Blog } from "@components/blog";
import ProjectsSection from "@components/projects.astro";
import { PhotographyPreview } from "@components/photography-preview";
import { Filmography } from "@components/filmography";
import { Graphics } from "@components/graphics";
import { Music } from "@components/music";
import { ModeToggle } from "@components/ModeToggle";
import Layout from "@layouts/Layout.astro";
---

<Layout>
  <ModeToggle client:load />
  <Home />
  <div class="flex justify-center py-8 h-120 bg-red-100">
    <div class="flex flex-col justify-center">
      <Blog />
    </div>
  </div>
  <div class="flex justify-center py-8 bg-blue-100">
    <div class="flex flex-col justify-center">
      <ProjectsSection />
    </div>
  </div>
  <div class="flex justify-center py-8 bg-green-100">
    <PhotographyPreview />
  </div>
  <div class="flex justify-center py-8 h-120 bg-cyan-100">
    <div class="flex flex-col justify-center">
      <Filmography />
    </div>
  </div>
  <div class="flex justify-center py-8 h-120 bg-yellow-100">
    <div class="flex flex-col justify-center">
      <Graphics />
    </div>
  </div>
  <div class="flex justify-center py-8 h-120 bg-mauve-100">
    <div class="flex flex-col justify-center">
      <Music />
    </div>
  </div>
</Layout>
