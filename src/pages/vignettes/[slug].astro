---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import { Vignettes, VignettesContent } from "@features/vignettes/vignettes";
import { VignettesInteractive } from "@features/vignettes/vignettes-interactive";
import { VignettesMenu } from "@features/vignettes/vignettes-menu";

const vignettes = (await getCollection("vignettes"))
  .filter(({ data }) => data.enabled)
  .sort((a, b) => a.data.order - b.data.order)
  .map(({ data }) => data);
const activeVignette = vignettes.find(({ slug }) => slug === Astro.params.slug);

if (!activeVignette) return new Response(null, { status: 404 });
---

<Layout>
  <Vignettes>
    <VignettesMenu client:load />
    <VignettesContent>
      <VignettesInteractive
        vignettes={vignettes}
        activeVignette={activeVignette}
        client:load
      />
    </VignettesContent>
  </Vignettes>
</Layout>
