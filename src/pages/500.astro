---
import Layout from "@layouts/Layout.astro";
import {
  ErrorPage,
  ErrorPageContent,
  ErrorPageDescription,
  ErrorPageEyebrow,
  ErrorPageHeader,
  ErrorPageTitle,
} from "@components/error-page";
import { Link } from "@components/link";
import RockBall from "@components/rock-ball.astro";
import { R2_PUBLIC_URL } from "astro:env/server";
---

<Layout
  title="Server error"
  description="The server could not complete the request; try again, and if the problem persists use the contact page to report it."
  noindex
>
  <div class="flex w-full flex-1 flex-col overflow-x-clip md:flex-row">
    <div
      aria-hidden="true"
      class="relative hidden animate-fade-in overflow-hidden bg-(image:--background-image) bg-cover bg-center md:block md:flex-1"
      style={{ "--background-image": `url("${R2_PUBLIC_URL}/500.webp")` }}
    ></div>
    <ErrorPage className="relative bg-background md:mx-0 md:w-160 md:max-w-none md:flex-none">
      <ErrorPageEyebrow className="animate-fade-in">Server error</ErrorPageEyebrow>
      <ErrorPageHeader className="flex-row items-end justify-between gap-4">
        <ErrorPageTitle className="animate-fade-in animation-delay-150">
          500<span class="sr-only"> Something went wrong</span>
        </ErrorPageTitle>
        <span class="animate-fade-in animation-delay-300">
          <RockBall />
        </span>
      </ErrorPageHeader>
      <ErrorPageDescription className="animate-fade-up animation-delay-1000">
        The server could not complete the request. Try again, and if the problem persists, use
        the <Link href="/contact">Contact</Link> page to report it.
      </ErrorPageDescription>

      <ErrorPageContent>
        <div
          class="flex animate-fade-up flex-col gap-1 text-sm leading-relaxed text-muted-foreground animation-delay-1150"
        >
          <p class="text-2xs font-semibold tracking-wider text-foreground uppercase">For agents</p>
          <p>
            Read <Link href="/llms.txt">/llms.txt</Link> for the published pages or <Link
              href="/developers">/developers</Link
            > for the interface.
          </p>
        </div>
      </ErrorPageContent>
    </ErrorPage>
  </div>
</Layout>
