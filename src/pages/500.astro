---
import Layout from "@layouts/Layout.astro";
import { Link } from "@components/link";
---

<Layout
  title="Server error"
  description="The server could not complete the request; try again, and if the problem persists use the contact page to report it."
>
  <div class="mx-auto min-h-screen max-w-3xl px-4 py-16 text-foreground md:px-8">
    <h1 class="mb-4 text-4xl font-semibold">Something went wrong</h1>
    <p class="mb-6">
      The server could not complete the request. Try again, and if the problem
      persists use the contact page to report it.
    </p>
    <nav class="flex flex-wrap gap-4">
      <Link href="/">Home</Link>
      <Link href="/contact">Contact</Link>
      <Link href="/llms.txt">Agent guide</Link>
    </nav>
  </div>
</Layout>
