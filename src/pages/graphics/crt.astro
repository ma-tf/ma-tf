---
import Layout from "@layouts/Layout.astro";
import {
  Crt,
  CrtContent,
  CrtDescription,
  CrtHeader,
  CrtTitle,
  CrtWorkbench,
} from "@features/crt/crt";
---

<Layout
  title="CRT"
  description="A cathode-ray screen effect by Matt Fehrenbach: upload an image to see it as broadcast phosphor dots on tilted glass, and save it as a PNG."
>
  <Crt>
    <CrtHeader>
      <CrtTitle>CRT</CrtTitle>
      <CrtDescription>
        Shows an image through a cathode-ray screen, as broadcast phosphor dots
        on tilted glass, and saves the result as a PNG.
      </CrtDescription>
    </CrtHeader>
    <CrtContent>
      <CrtWorkbench client:load />
    </CrtContent>
  </Crt>
</Layout>
