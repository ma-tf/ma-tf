---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import {
  ProjectRow,
  ProjectRowBody,
  ProjectRowContent,
  ProjectRowNumber,
  ProjectRowTitle,
  ProjectRowTopic,
  ProjectRowTopics,
  Projects,
  ProjectsContent,
  ProjectsDescription,
  ProjectsHeader,
  ProjectsTitle,
} from "@features/projects/projects";

const entries = await getCollection("projects");
const projects = entries.map((entry) => ({
  title: entry.data.title,
  url: entry.data.url,
  topics: entry.data.topics,
  body: entry.body ?? "",
}));
---

<Layout title="Projects" description="Projects by Matt Fehrenbach.">
  <Projects>
    <ProjectsHeader>
      <ProjectsTitle>projects</ProjectsTitle>
      <ProjectsDescription>
        Software and side projects I build and ship.
      </ProjectsDescription>
    </ProjectsHeader>
    <ProjectsContent>
      {
        projects.map((project, index) => (
          <ProjectRow>
            <ProjectRowNumber>{String(index + 1).padStart(2, "0")}</ProjectRowNumber>
            <ProjectRowTitle href={project.url}>{project.title}</ProjectRowTitle>
            <ProjectRowContent>
              <ProjectRowBody>{project.body}</ProjectRowBody>
              <ProjectRowTopics>
                {project.topics.map((topic) => (
                  <ProjectRowTopic>{topic}</ProjectRowTopic>
                ))}
              </ProjectRowTopics>
            </ProjectRowContent>
          </ProjectRow>
        ))
      }
    </ProjectsContent>
  </Projects>
</Layout>
