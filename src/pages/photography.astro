---
import Layout from "@layouts/Layout.astro";
import { ModeToggle } from "@components/ModeToggle";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";

const photos = await getCollection("photography");
const columns = [1, 2, 3].map((col) =>
	photos
		.filter((p) => p.data.column === col)
		.sort((a, b) => a.data.order - b.data.order),
);
---

<Layout>
	<ModeToggle client:load />
	<div class="grid grid-cols-1 lg:grid-cols-6 auto-rows-auto gap-4">
		<div class="lg:col-span-2">
			<h2>Look at my photographs</h2>
			<p>Here I shall talk about my photographs</p>
		</div>
		<div class="grid grid-cols-1 gap-4 lg:grid-cols-3 lg:col-span-4">
			{columns.map((col) => (
				<div class="flex flex-col gap-4">
					{col.map((photo) => (
						<Image
							src={photo.data.image}
							alt={photo.body || "Photography"}
							quality={"mid"}
							width={500}
							height={500}
							class="object-cover size-full"
						/>
					))}
				</div>
			))}
		</div>
	</div>
</Layout>
