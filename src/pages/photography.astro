---
import Layout from "@layouts/Layout.astro";
import { ModeToggle } from "@components/ModeToggle";
import PhotoGrid from "@components/photo-grid.astro";
import {
	PhotographDescriptionContent,
	PhotographDescriptionHeader,
} from "@components/photograph";
---

<Layout>
	<ModeToggle client:load />
	<div class="grid grid-cols-1 lg:grid-cols-6 auto-rows-auto gap-4">
		<div class="lg:col-span-2 p-4 flex-col flex gap-4">
			<PhotographDescriptionHeader>photographs</PhotographDescriptionHeader>
			<PhotographDescriptionContent>
				In my spare time I am an amatuer photographer. The photographs I take
				are in both digital and film formats. I have collected many cameras over
				the last few years. The cameras I use include:
				<ul>
					<li>
						a <span class="italic">Canon EOS-1V</span> as my primary camera with swappable
						lenses;
					</li>
					<li>
						an <span class="italic">Olympus mju mini Digital</span> for when I want
						retro digital shots;
					</li>
					<li>
						a <span class="italic">Ricoh Mirai</span> when I need an all rounder bridge
						camera.
					</li>
				</ul>
				Each one covers a use case of mine, and they have served me well so far.
			</PhotographDescriptionContent>
		</div>
		<PhotoGrid />
	</div>
</Layout>
