---
import Layout from "@layouts/Layout.astro";
import { getCollection } from "astro:content";
import { ModeToggle } from "@components/ModeToggle";
import { BlogPage } from "@components/blog-page";
import { getImage } from "astro:assets";
import { S3Client, GetObjectCommand } from "@aws-sdk/client-s3";
import { getSignedUrl } from "@aws-sdk/s3-request-presigner";

const s3 = new S3Client({
  region: "auto",
  endpoint: import.meta.env.R2_ENDPOINT,
  credentials: {
    accessKeyId: import.meta.env.R2_ACCESS_KEY_ID,
    secretAccessKey: import.meta.env.R2_SECRET_ACCESS_KEY,
  },
});

async function getBackground(key: string) {
  const signedUrl = await getSignedUrl(
    s3,
    new GetObjectCommand({ Bucket: import.meta.env.R2_BUCKET, Key: key }),
    { expiresIn: 3600 },
  );
  return (await getImage({ src: signedUrl, inferSize: true })).src;
}

const backBg = await getBackground("blog/blog-bg-back.webp");
const frontBg = await getBackground("blog/blog-bg-front.webp");

const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const plainPosts = posts.map((p) => ({
  slug: p.data.slug,
  title: p.data.title,
  description: p.data.description,
  pubDate: p.data.pubDate.toISOString(),
}));
---

<Layout>
  <ModeToggle client:load />
  <BlogPage
    client:load
    title="blog"
    description="I write about web development, creative coding, and things I learn along the way."
    posts={plainPosts}
    backgrounds={{ back: backBg, front: frontBg }}
  />
</Layout>
