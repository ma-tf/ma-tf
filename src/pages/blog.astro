---
import Layout from "@layouts/Layout.astro";
import {
  Blog,
  BlogBackgrounds,
  BlogContent,
  BlogDescription,
  BlogHeader,
  BlogMobileNavigation,
  BlogNavigation,
  BlogPage,
  BlogPostList,
  BlogTitle,
} from "@features/blog/blog";
import { getPosts } from "@features/blog/post-data";
import { R2_PUBLIC_URL } from "astro:env/server";

const plainPosts = await getPosts();
---

<Layout>
  <BlogPage>
    <BlogBackgrounds baseUrl={R2_PUBLIC_URL} />
    <Blog>
      <BlogHeader>
        <BlogMobileNavigation client:load className="animate-fade-up" />
        <BlogTitle data-parallax={30} className="animate-fade-up"
          >blog</BlogTitle
        >
        <BlogDescription
          data-parallax={60}
          className="animate-fade-up animation-delay-50"
          >I write about web development, creative coding, and things I learn
          along the way.</BlogDescription
        >
        <BlogNavigation
          data-parallax={60}
          className="animate-fade-up animation-delay-100"
        />
      </BlogHeader>
      <BlogContent>
        <BlogPostList data-parallax={100} posts={plainPosts} />
      </BlogContent>
    </Blog>
  </BlogPage>
</Layout>

<script>
  import { startBlogScroll } from "@lib/blog-scroll";

  startBlogScroll();
</script>
