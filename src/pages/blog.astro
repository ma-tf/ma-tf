---
import Layout from "@layouts/Layout.astro";
import { getPosts } from "@features/blog/post-data";
import { ModeToggle } from "@components/ModeToggle";
import { BlogPage } from "@features/blog/blog-page";

const backBg = `${import.meta.env.R2_PUBLIC_URL}/blog/blog-bg-back.webp`;
const frontBg = `${import.meta.env.R2_PUBLIC_URL}/blog/blog-bg-front.webp`;

const plainPosts = await getPosts();
---

<Layout>
  <ModeToggle client:load />
  <BlogPage
    client:load
    title="blog"
    description="I write about web development, creative coding, and things I learn along the way."
    posts={plainPosts}
    backgrounds={{ back: backBg, front: frontBg }}
  />
</Layout>
