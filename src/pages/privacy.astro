---
import Layout from "@layouts/Layout.astro";
import { Link } from "@components/link";
import { ArrowSquareOutIcon } from "@phosphor-icons/react";
import { StillLifeCard } from "@components/still-life-hero";
import StillLifePage from "@components/still-life-page.astro";
import { PrivacyTitle } from "@features/privacy/privacy";
import { CDN_BASE } from "@lib/cdn";
---

<Layout>
  <StillLifePage baseUrl={`${CDN_BASE}/about`}>
    <Fragment slot="title"><PrivacyTitle>Privacy</PrivacyTitle></Fragment>
    <StillLifeCard
      data-parallax={10}
      className="animate-reveal md:opacity-100 md:transform-none md:animate-fade-in md:animation-delay-2000"
    >
      <div
        data-parallax={5}
        class="flex flex-col gap-3 p-4 md:p-2 md:animate-fade-up md:animation-delay-2300"
      >
        <p>
          The site has no analytics, advertising or tracking cookies. It keeps
          three anonymous counts: one hit per browser session, one entry a day
          for unique readers, and readers active in the last 90 seconds. The
          last two use a salted hash of the request address; the address itself
          is never stored and the hash cannot be reversed to one. No cookie or
          identifier is written to your device.
        </p>
      </div>
    </StillLifeCard>
    <StillLifeCard
      data-parallax={15}
      className="animate-reveal md:opacity-100 md:transform-none md:animate-fade-in md:animation-delay-2150"
    >
      <div
        data-parallax={10}
        class="flex flex-col gap-3 p-4 md:p-2 md:animate-fade-up md:animation-delay-2450"
      >
        <p>
          The site has no forms that collect personal information. Some pages
          embed media from Bandcamp and Mixcloud, which may receive requests
          from your browser under their own privacy policies. The site also
          loads the Inter font from Google Fonts.
        </p>
      </div>
    </StillLifeCard>
    <StillLifeCard
      data-parallax={20}
      className="animate-reveal md:opacity-100 md:transform-none md:animate-fade-in md:animation-delay-2300"
    >
      <div
        data-parallax={15}
        class="flex flex-col gap-3 p-4 md:p-2 md:animate-fade-up md:animation-delay-2600"
      >
        <p>
          If you have a question about privacy on this site, see the <Link
            href="/contact"
            className="inline-flex items-center gap-1"
          >
            Contact
            <ArrowSquareOutIcon className="size-3 shrink-0" aria-hidden="true" />
          </Link> page.
        </p>
      </div>
    </StillLifeCard>
  </StillLifePage>
</Layout>
