---
import Layout from "@layouts/Layout.astro";
import { Link } from "@components/link";
import { ArrowSquareOutIcon } from "@phosphor-icons/react";
import { StillLifeCard } from "@components/still-life-hero";
import StillLifePage from "@components/still-life-page.astro";
import { PrivacyTitle } from "@features/privacy/privacy";
import { R2_PUBLIC_URL } from "astro:env/server";
---

<Layout>
  <StillLifePage baseUrl={`${R2_PUBLIC_URL}/about`}>
    <Fragment slot="title"><PrivacyTitle>Privacy</PrivacyTitle></Fragment>
    <StillLifeCard
      className="animate-reveal md:opacity-100 md:transform-none"
    >
      <div
        class="flex flex-col gap-3 p-4 md:p-2 md:animate-fade-up md:animation-delay-1050"
      >
        <p>
          This site does not use first-party analytics, advertising, or tracking
          cookies. It does not provide forms that collect personal information,
          and no personal information is intentionally stored by the site.
        </p>
      </div>
    </StillLifeCard>
    <StillLifeCard
      className="animate-reveal md:opacity-100 md:transform-none"
    >
      <div
        class="flex flex-col gap-3 p-4 md:p-2 md:animate-fade-up md:animation-delay-1100"
      >
        <p>
          Some pages embed media from Bandcamp and Mixcloud. These services may
          receive requests from your browser and may process information
          according to their own privacy policies. The site also loads the Inter
          font from Google Fonts.
        </p>
      </div>
    </StillLifeCard>
    <StillLifeCard
      className="animate-reveal md:opacity-100 md:transform-none"
    >
      <div
        class="flex flex-col gap-3 p-4 md:p-2 md:animate-fade-up md:animation-delay-1150"
      >
        <p>
          If you have a question about privacy on this site, see the <Link
            href="/contact"
            className="inline-flex items-center gap-1"
          >
            Contact
            <ArrowSquareOutIcon className="size-3 shrink-0" aria-hidden="true" />
          </Link> page.
        </p>
      </div>
    </StillLifeCard>
  </StillLifePage>
</Layout>
