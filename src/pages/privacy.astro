---
import Layout from "@layouts/Layout.astro";
import { StillLifeBackground } from "@components/still-life-background";
import {
  Privacy,
  PrivacyCard,
  PrivacyContent,
  PrivacyHeader,
  PrivacyScrollCue,
  PrivacyTitle,
} from "@features/privacy/privacy";
---

<Layout>
  <div class="relative w-full self-center max-w-480 md:overflow-hidden border-l">
    <Privacy>
      <StillLifeBackground
        baseUrl={`${import.meta.env.R2_PUBLIC_URL}/about`}
        scrollDistance={1.5}
        scrollDrift={0.4}
        scrollScale={1.15}
        className="sticky top-0 col-start-1 row-start-1 h-lvh"
      />
      <PrivacyHeader>
        <PrivacyTitle>Privacy</PrivacyTitle>
        <PrivacyScrollCue />
      </PrivacyHeader>
      <PrivacyContent>
        <section
          class="text-base leading-relaxed flex flex-col gap-12 pb-36 pt-12 md:flex-row md:gap-9 md:pb-64 md:pl-16 md:text-xs"
          data-parallax={40}
        >
          <PrivacyCard className="animate-reveal">
            <div
              class="flex flex-col gap-3 p-2 md:animate-fade-up md:animation-delay-1050"
              data-parallax={10}
            >
              <p>
                This site does not use first-party analytics, advertising, or
                tracking cookies. It does not provide forms that collect
                personal information, and no personal information is
                intentionally stored by the site.
              </p>
            </div>
          </PrivacyCard>
          <PrivacyCard className="animate-reveal">
            <div
              class="flex flex-col gap-3 p-2 md:animate-fade-up md:animation-delay-1100"
              data-parallax={17}
            >
              <p>
                Some pages embed media from Bandcamp and Mixcloud. These
                services may receive requests from your browser and may process
                information according to their own privacy policies. The site
                also loads the Inter font from Google Fonts.
              </p>
            </div>
          </PrivacyCard>
          <PrivacyCard className="animate-reveal">
            <div
              class="flex flex-col gap-3 p-2 md:animate-fade-up md:animation-delay-1150"
              data-parallax={23}
            >
              <p>
                If you have a question about privacy on this site, see the <a
                  href="/contact"
                  class="underline underline-offset-4 hover:text-foreground/70"
                  >contact page</a
                >.
              </p>
            </div>
          </PrivacyCard>
        </section>
      </PrivacyContent>
    </Privacy>
  </div>
</Layout>
