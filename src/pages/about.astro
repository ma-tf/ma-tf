---
import Layout from "@layouts/Layout.astro";
import { StillLifeBackground } from "@components/still-life-background";
import {
  About,
  AboutCard,
  AboutContent,
  AboutHeader,
  AboutTitle,
} from "@features/about/about";
import { siteIdentity } from "@features/seo/site-metadata";
---

<Layout>
  <div
    class="relative w-full self-center max-w-480 md:overflow-hidden border-l"
  >
    <About>
      <StillLifeBackground
        baseUrl={`${import.meta.env.R2_PUBLIC_URL}/about`}
        scrollDistance={3}
        scrollDrift={0.4}
        scrollScale={1.15}
        className="sticky top-0 col-start-1 row-start-1 h-dvh"
      />
      <AboutHeader>
        <AboutTitle>About</AboutTitle>
      </AboutHeader>
      <AboutContent>
        <section
          class="text-base leading-relaxed flex flex-col gap-12 pb-36 pt-12 md:flex-row md:gap-9 md:pb-64 md:pl-16 md:text-sm"
          data-parallax={40}
        >
          <AboutCard data-parallax={3}>
            <p
              class="p-2 animate-reveal md:animate-fade-up md:animation-delay-1050"
              data-parallax={10}
            >
              I'm {siteIdentity.name}, a full-stack developer. I started
              programming in 2013 and began working professionally in 2018. My
              experience spans public safety, finance, and intellectual
              property.
            </p>
          </AboutCard>
          <AboutCard data-parallax={5}>
            <p
              class="p-2 animate-reveal md:animate-fade-up md:animation-delay-1100"
              data-parallax={17}
            >
              This site is a record of the things I make and learn. Alongside
              software projects and writing, it includes photography, graphics,
              music, and other creative experiments.
            </p>
          </AboutCard>
          <AboutCard data-parallax={7}>
            <p
              class="p-2 animate-reveal md:animate-fade-up md:animation-delay-1150"
              data-parallax={23}
            >
              You can read about my professional experience on the <a
                href="/cv"
                class="underline underline-offset-4 hover:text-foreground/70"
                >CV</a
              > page, or browse the projects and creative work from the home page.
            </p>
          </AboutCard>
        </section>
      </AboutContent>
    </About>
  </div>
</Layout>
