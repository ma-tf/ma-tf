---
import Layout from "@layouts/Layout.astro";
import { Link } from "@components/link";
import { ArrowSquareOutIcon } from "@phosphor-icons/react";
import { StillLifeCard } from "@components/still-life-hero";
import StillLifePage from "@components/still-life-page.astro";
import { AboutTitle } from "@features/about/about";
import { AskPanel } from "@features/faq/ask";
import { siteIdentity } from "@features/seo/site-metadata";
import { askEnabled } from "@lib/feature-flags";
import { R2_PUBLIC_URL } from "astro:env/server";
---

<Layout>
  <StillLifePage baseUrl={`${R2_PUBLIC_URL}/about`}>
    <Fragment slot="title"><AboutTitle>About</AboutTitle></Fragment>
    {askEnabled && (
    <Fragment slot="header-aside">
      <StillLifeCard
        data-parallax={30}
        className="hidden animate-reveal md:col-span-3 md:col-start-7 md:row-start-1 md:block md:self-end md:opacity-100 md:transform-none md:animate-fade-in md:animation-delay-2300"
      >
        <div
          data-parallax={10}
          class="relative flex flex-col px-4 pt-6 pb-4 md:px-2 md:pt-4 md:pb-2"
        >
          <h2
            class="absolute top-0 left-4 -mt-2 text-xs font-semibold tracking-wider uppercase md:left-2 md:animate-fade-up md:animation-delay-2900"
          >
            Questions
          </h2>
          <div class="md:animate-fade-up md:animation-delay-3500">
            <AskPanel client:visible />
          </div>
        </div>
      </StillLifeCard>
    </Fragment>
    )}
    <StillLifeCard
      data-parallax={10}
      className="animate-reveal md:opacity-100 md:transform-none md:animate-fade-in md:animation-delay-2000"
    >
      <p
        data-parallax={5}
        class="p-4 md:p-2 md:animate-fade-up md:animation-delay-2300"
      >
        I'm {siteIdentity.name}, a full-stack developer. I started programming in
        2013 and began working professionally in 2018. My experience spans public
        safety, finance, and intellectual property.
      </p>
    </StillLifeCard>
    <StillLifeCard
      data-parallax={15}
      className="animate-reveal md:opacity-100 md:transform-none md:animate-fade-in md:animation-delay-2150"
    >
      <p
        data-parallax={10}
        class="p-4 md:p-2 md:animate-fade-up md:animation-delay-2450"
      >
        This site is a record of the things I make and learn. Alongside software
        projects and writing, it includes photography, graphics, music, and other
        creative experiments.
      </p>
    </StillLifeCard>
    <StillLifeCard
      data-parallax={20}
      className="animate-reveal md:opacity-100 md:transform-none md:animate-fade-in md:animation-delay-2300"
    >
      <p
        data-parallax={15}
        class="p-4 md:p-2 md:animate-fade-up md:animation-delay-2600"
      >
        You can read about my professional experience on the <Link
          href="/cv"
          className="inline-flex items-center gap-1"
        >
          CV
          <ArrowSquareOutIcon className="size-3 shrink-0" aria-hidden="true" />
        </Link> page, or browse the projects and creative work from the home
        page.
      </p>
    </StillLifeCard>
    {askEnabled && (
    <StillLifeCard
      data-parallax={25}
      className="animate-reveal md:hidden"
    >
      <div
        data-parallax={20}
        class="relative flex flex-col px-4 pt-6 pb-4"
      >
        <h2
          class="absolute top-0 left-4 -mt-2 text-xs font-semibold tracking-wider uppercase"
        >
          Questions
        </h2>
        <AskPanel client:visible />
      </div>
    </StillLifeCard>
    )}
  </StillLifePage>
</Layout>
